#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! command -v nix >/dev/null 2>&1; then
    echo "[pre-commit] nix is required for the strict-enum check." >&2
    exit 1
fi

echo "[pre-commit] checking strict enum types"
nix develop .#build --command bash -lc \
    'set -e; homm2 clangd >/dev/null; python -m homm2.build.clang_cxx11 --errors-only'
