HOMM2_MESSAGE("table.gSPanelHelp.0", "{OK}\n\nExit this menu.")
HOMM2_MESSAGE("table.gSPanelHelp.1", "{Music}\n\nToggle ambient music level.")
HOMM2_MESSAGE("table.gSPanelHelp.2", "{Effects}\n\nToggle foreground sounds level.")
HOMM2_MESSAGE("table.gSPanelHelp.3", "{Speed}\n\nChange the speed at which your heroes move on the main screen.")
HOMM2_MESSAGE("table.gSPanelHelp.4", "{Music Type}\n\nHeroes II uses MIDI music.")
HOMM2_MESSAGE("table.gSPanelHelp.5", "{Show Path}\n\nToggle 'Show Path' on/off.  If 'Show Path' is on, your first click on a map location will show the path to get there, your second will start you moving. If this option is off, one click starts you moving immediately.")
HOMM2_MESSAGE("table.gSPanelHelp.6", "{Enemy Speed}\n\nSets the speed that A.I. heroes move at.  You can also elect not to view A.I. movement at all.")
HOMM2_MESSAGE("table.gSPanelHelp.7", "{Interface}\n\nSets what type of interface you want to use.  The default selection is a dynamic interface, which uses Evil graphics for the 3 evil heroes (Barbarian, Warlock, and Necromancer).")
HOMM2_MESSAGE("table.gSPanelHelp.8", "{Video}\n\nDetermines if the video sequences play normally or in interlaced mode. Interlaced mode runs better on slower machines.")
HOMM2_MESSAGE("table.gSPanelHelp.9", "{Mouse Cursor}\n\nToggle color cursors on/off.  Color cursors look nicer, but sometimes don't move as smoothly as black and white ones.")
