HOMM2_MESSAGE("table.gStatDesc.0", "{Attack Skill}\n\nYour attack skill is a bonus added to each creature's attack skill.")
HOMM2_MESSAGE("table.gStatDesc.1", "{Defense Skill}\n\nYour defense skill is a bonus added to each creature's defense skill.")
HOMM2_MESSAGE("table.gStatDesc.2", "{Spell Power}\n\nYour spell power determines the length or power of a spell.")
HOMM2_MESSAGE("table.gStatDesc.3", "{Knowledge}\n\nYour knowledge determines how many spell points your hero may have.  Under normal cirumstances, a hero is limited to 10 spell points per level of knowledge.")
