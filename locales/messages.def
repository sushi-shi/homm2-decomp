HOMM2_MESSAGE("table.cWinComError.0", "Communications error on function '%s'\n\nWin95 Error Code: %d\nWin95 Error Meaning: %s\n\n")
HOMM2_MESSAGE("table.cWinComError.1", "Suggested solutions:")
HOMM2_MESSAGE("table.cWinComError.2", "\n  1) Make sure all cables are firmly connected.")
HOMM2_MESSAGE("table.cWinComError.3", "\n  2) Reboot computer.")
HOMM2_MESSAGE("table.cWinComError.4", "\n  3) Check to make sure you have the correct COM port setting in 'CONFIG'. (The 3rd button down on the screen where you choose Host or Guest.)")
HOMM2_MESSAGE("table.cWinComError.5", "\n  4) Consider lowering the BAUD rate in 'CONFIG' to 19200 or 9600.")
