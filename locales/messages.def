HOMM2_MESSAGE("table.gArtifactNames.12", "Medal of Valor")
HOMM2_MESSAGE("table.gArtifactNames.13", "Medal of Courage")
HOMM2_MESSAGE("table.gArtifactNames.14", "Medal of Honor")
HOMM2_MESSAGE("table.gArtifactNames.15", "Medal of Distinction")
HOMM2_MESSAGE("table.gArtifactNames.16", "Fizbin of Misfortune")
HOMM2_MESSAGE("table.gArtifactNames.17", "Thunder Mace of Dominion")
HOMM2_MESSAGE("table.gArtifactNames.18", "Armored Gauntlets of Protection")
HOMM2_MESSAGE("table.gArtifactNames.19", "Defender Helm of Protection")
HOMM2_MESSAGE("table.gArtifactNames.2", "Ultimate Cloak of Protection")
