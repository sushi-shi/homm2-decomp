HOMM2_MESSAGE("table.gArtifactNames.21", "Ballista of Quickness")
HOMM2_MESSAGE("table.gArtifactNames.22", "Stealth Shield of Protection")
HOMM2_MESSAGE("table.gArtifactNames.23", "Dragon Sword of Dominion")
HOMM2_MESSAGE("table.gArtifactNames.24", "Power Axe of Dominion")
HOMM2_MESSAGE("table.gArtifactNames.25", "Divine Breastplate of Protection")
HOMM2_MESSAGE("table.gArtifactNames.26", "Minor Scroll of Knowledge")
HOMM2_MESSAGE("table.gArtifactNames.27", "Major Scroll of Knowledge")
HOMM2_MESSAGE("table.gArtifactNames.28", "Superior Scroll of Knowledge")
HOMM2_MESSAGE("table.gArtifactNames.29", "Foremost Scroll of Knowledge")
HOMM2_MESSAGE("table.gArtifactNames.3", "Ultimate Wand of Magic")
HOMM2_MESSAGE("table.gArtifactNames.30", "Endless Sack of Gold")
HOMM2_MESSAGE("table.gArtifactNames.31", "Endless Bag of Gold")
HOMM2_MESSAGE("table.gArtifactNames.32", "Endless Purse of Gold")
HOMM2_MESSAGE("table.gArtifactNames.33", "Nomad Boots of Mobility")
HOMM2_MESSAGE("table.gArtifactNames.34", "Traveler's Boots of Mobility")
HOMM2_MESSAGE("table.gArtifactNames.35", "Lucky Rabbit's Foot")
HOMM2_MESSAGE("table.gArtifactNames.36", "Golden Horseshoe")
HOMM2_MESSAGE("table.gArtifactNames.37", "Gambler's Lucky Coin")
HOMM2_MESSAGE("table.gArtifactNames.38", "Four-Leaf Clover")
HOMM2_MESSAGE("table.gArtifactNames.39", "True Compass of Mobility")
HOMM2_MESSAGE("table.gArtifactNames.4", "Ultimate Shield")
HOMM2_MESSAGE("table.gArtifactNames.40", "Sailor's Astrolabe of Mobility")
HOMM2_MESSAGE("table.gArtifactNames.41", "Evil Eye")
HOMM2_MESSAGE("table.gArtifactNames.42", "Enchanted Hourglass")
HOMM2_MESSAGE("table.gArtifactNames.43", "Gold Watch")
HOMM2_MESSAGE("table.gArtifactNames.44", "Skullcap")
HOMM2_MESSAGE("table.gArtifactNames.45", "Ice Cloak")
HOMM2_MESSAGE("table.gArtifactNames.46", "Fire Cloak")
HOMM2_MESSAGE("table.gArtifactNames.47", "Lightning Helm")
HOMM2_MESSAGE("table.gArtifactNames.48", "Evercold Icicle")
HOMM2_MESSAGE("table.gArtifactNames.49", "Everhot Lava Rock")
HOMM2_MESSAGE("table.gArtifactNames.5", "Ultimate Staff")
HOMM2_MESSAGE("table.gArtifactNames.50", "Lightning Rod ")
HOMM2_MESSAGE("table.gArtifactNames.51", "Snake-Ring")
HOMM2_MESSAGE("table.gArtifactNames.52", "Ankh")
HOMM2_MESSAGE("table.gArtifactNames.53", "Book of Elements")
HOMM2_MESSAGE("table.gArtifactNames.54", "Elemental Ring")
HOMM2_MESSAGE("table.gArtifactNames.55", "Holy Pendant")
