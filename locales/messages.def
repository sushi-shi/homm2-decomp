HOMM2_MESSAGE("table.cLongCombatHelp.0", "{Wait}\n\nHave the current creature wait to take its turn until all the other creatures have gone.  The creature does not lose its turn.")
HOMM2_MESSAGE("table.cLongCombatHelp.1", "{Skip}\n\nSkips the current creature.  The current creature loses its turn and does not get to go again until the next round.")
