HOMM2_MESSAGE("table.gSetupBaudHelp.0", "{2400 Baud}\n\nUse a 2400 baud connection speed. \n\nNote: For a 14400 baud modem, use the 19200 baud speed.  For a 28800 baud modem, use the 38400 baud speed.")
HOMM2_MESSAGE("table.gSetupBaudHelp.1", "{9600 Baud}\n\nUse a 9600 baud connection speed. \n\nNote: For a 14400 baud modem, use the 19200 baud speed.  For a 28800 baud modem, use the 38400 baud speed.")
HOMM2_MESSAGE("table.gSetupBaudHelp.2", "{19200 Baud}\n\nUse a 19200 baud connection speed.\n\nNote: For a 14400 baud modem, use the 19200 baud speed.  For a 28800 baud modem, use the 38400 baud speed.")
HOMM2_MESSAGE("table.gSetupBaudHelp.3", "{38400 Baud}\n\nUse a 38400 baud connection speed.\n\nNote: For a 14400 baud modem, use the 19200 baud speed.  For a 28800 baud modem, use the 38400 baud speed.")
HOMM2_MESSAGE("table.gSetupBaudHelp.4", "{Cancel}\n\nCancel back to the main menu.")
HOMM2_MESSAGE("table.gSetupComPortHelp.0", "{COM 1}\n\nUse COM Port 1 for the modem connection.")
HOMM2_MESSAGE("table.gSetupComPortHelp.1", "{COM 2}\n\nUse COM Port 2 for the modem connection.")
HOMM2_MESSAGE("table.gSetupComPortHelp.2", "{COM 3}\n\nUse COM Port 3 for the modem connection.")
HOMM2_MESSAGE("table.gSetupComPortHelp.3", "{COM 4}\n\nUse COM Port 4 for the modem connection.")
HOMM2_MESSAGE("table.gSetupComPortHelp.4", "{Cancel}\n\nCancel back to the main menu.")
HOMM2_MESSAGE("table.gSetupDCBaudHelp.0", "{2400 Baud}\n\nUse a 2400 baud connection speed. \n\nNote: In general, computers with the older UART 8250 chip should use 19200 baud, and computers with the newer UART 16550 chip should use 38400 baud.  When in doubt, try slower speeds first, and if they work, then try faster speeds.  Most computers made in 1994 or later have a UART 16550 chip.")
HOMM2_MESSAGE("table.gSetupDCBaudHelp.1", "{9600 Baud}\n\nUse a 9600 baud connection speed. \n\nNote: In general, computers with the older UART 8250 chip should use 19200 baud, and computers with the newer UART 16550 chip should use 38400 baud.  When in doubt, try slower speeds first, and if they work, then try faster speeds.  Most computers made in 1994 or later have a UART 16550 chip.")
HOMM2_MESSAGE("table.gSetupDCBaudHelp.2", "{19200 Baud}\n\nUse a 19200 baud connection speed.\n\nNote: In general, computers with the older UART 8250 chip should use 19200 baud, and computers with the newer UART 16550 chip should use 38400 baud.  When in doubt, try slower speeds first, and if they work, then try faster speeds.  Most computers made in 1994 or later have a UART 16550 chip.")
HOMM2_MESSAGE("table.gSetupDCBaudHelp.3", "{38400 Baud}\n\nUse a 38400 baud connection speed.\n\nNote: In general, computers with the older UART 8250 chip should use 19200 baud, and computers with the newer UART 16550 chip should use 38400 baud.  When in doubt, try slower speeds first, and if they work, then try faster speeds.  Most computers made in 1994 or later have a UART 16550 chip.")
HOMM2_MESSAGE("table.gSetupDCBaudHelp.4", "{Cancel}\n\nCancel back to the main menu.")
HOMM2_MESSAGE("table.gSetupDCComPortHelp.0", "{COM 1}\n\nUse COM Port 1 for the direct connection.")
HOMM2_MESSAGE("table.gSetupDCComPortHelp.1", "{COM 2}\n\nUse COM Port 2 for the direct connection.")
HOMM2_MESSAGE("table.gSetupDCComPortHelp.2", "{COM 3}\n\nUse COM Port 3 for the direct connection.")
HOMM2_MESSAGE("table.gSetupDCComPortHelp.3", "{Com 4}\n\nUse COM Port 4 for the direct connection.")
HOMM2_MESSAGE("table.gSetupDCComPortHelp.4", "{Cancel}\n\nCancel back to the main menu.")
HOMM2_MESSAGE("table.gSetupDCGameHelp.0", "{Host}\n\nThe host sets up the game options.")
HOMM2_MESSAGE("table.gSetupDCGameHelp.1", "{Guest}\n\nThe guest waits for the host to set up the game.")
HOMM2_MESSAGE("table.gSetupDCGameHelp.2", "{Config}\n\nChange your direct connect port configuration.")
HOMM2_MESSAGE("table.gSetupDCGameHelp.3", "{Cancel}\n\nCancel back to the main menu.")
HOMM2_MESSAGE("table.gSetupGameHelp.0", "{Standard Game}\n\nA single player game playing out a single map.")
HOMM2_MESSAGE("table.gSetupGameHelp.1", "{Campaign Game}\n\nA single player game playing through a series of maps.")
HOMM2_MESSAGE("table.gSetupGameHelp.2", "{Multi-Player Game}\n\nA multi-player game, with several human players competing against each other on a single map.")
HOMM2_MESSAGE("table.gSetupGameHelp.3", "{Cancel}\n\nCancel back to the main menu.")
HOMM2_MESSAGE("table.gSetupHotSeatGameHelp.0", "{2 Players}\n\nPlay with 2 human players, and optionally, up to 4 additional computer players.")
HOMM2_MESSAGE("table.gSetupHotSeatGameHelp.1", "{3 Players}\n\nPlay with 3 human players, and optionally, up to 3 additional computer players.")
HOMM2_MESSAGE("table.gSetupHotSeatGameHelp.2", "{4 Players}\n\nPlay with 4 human players, and optionally, up to 2 additional computer players.")
HOMM2_MESSAGE("table.gSetupHotSeatGameHelp.3", "{5 Players}\n\nPlay with 5 human players, and optionally 1 computer player.")
HOMM2_MESSAGE("table.gSetupHotSeatGameHelp.4", "{6 Players}\n\nPlay with 6 human players.")
HOMM2_MESSAGE("table.gSetupHotSeatGameHelp.5", "{Cancel}\n\nCancel back to the main menu.")
HOMM2_MESSAGE("table.gSetupModemGameHelp.0", "{Host}\n\nThe host sets up the game options, chooses the number to dial, and places the call.")
HOMM2_MESSAGE("table.gSetupModemGameHelp.1", "{Guest}\n\nThe guest waits for the host to call and set up the game.")
HOMM2_MESSAGE("table.gSetupModemGameHelp.2", "{Config}\n\nChange your modem configuration.")
HOMM2_MESSAGE("table.gSetupModemGameHelp.3", "{Cancel}\n\nCancel back to the main menu.")
HOMM2_MESSAGE("table.gSetupMultiPlayerGameHelp.0", "{Hot Seat}\n\nPlay a Hot Seat game, where 2 to 4 players play around the same computer, switching into the 'Hot Seat' when it is their turn.")
HOMM2_MESSAGE("table.gSetupMultiPlayerGameHelp.1", "{Network}\n\nPlay a network game, where 2 players use their own computers connected through a LAN (Local Area Network).")
HOMM2_MESSAGE("table.gSetupMultiPlayerGameHelp.2", "{Modem}\n\nPlay a modem game, where 2 players use their own computers connected over the phone lines using modems.")
HOMM2_MESSAGE("table.gSetupMultiPlayerGameHelp.3", "{Direct Connect}\n\nPlay a direct connect game, where 2 players use their own computers directly connected through their serial port by a null modem.")
HOMM2_MESSAGE("table.gSetupMultiPlayerGameHelp.4", "{Cancel}\n\nCancel back to the main menu.")
HOMM2_MESSAGE("table.gSetupNetworkGame2Help.0", "{IPX}\n\nIPX networking is the most commonly used form of network in Windows 95.  Up to 6 players can play using IPX.  Only the Windows 95 version of Heroes II supports IPX networking.")
HOMM2_MESSAGE("table.gSetupNetworkGame2Help.1", "{TCP/IP}\n\nTCP/IP is most commonly used as a way of connecting machines over the internet.  Up to 6 players can play using IPX.  To connect over the internet, you must have an account with an ISP (Independent Service Provider).  Only the Windows 95 version of Heroes II supports TCP/IP networking.")
HOMM2_MESSAGE("table.gSetupNetworkGame2Help.2", "{NETBios}\n\nNETBios networking is the only form of networking available for DOS machines, and is also available for Windows 95.  Only two players may connect with NetBIOS.  If all machines you wish to connect are using the Windows 95 version of Heroes II, then IPX networking is recommended.")
HOMM2_MESSAGE("table.gSetupNetworkGame2Help.3", "{Cancel}\n\nCancel back to the main menu.")
HOMM2_MESSAGE("table.gSetupNetworkGameHelp.0", "{Host}\n\nThe host sets up the game options.  There can only be one host per network game.")
HOMM2_MESSAGE("table.gSetupNetworkGameHelp.1", "{Guest}\n\nThe guest waits for the host to set up the game, then is automatically added in.  There can be multiple guests for TCP/IP and IPX games, but only 1 guest for NetBIOS games.")
HOMM2_MESSAGE("table.gSetupNetworkGameHelp.2", "{Cancel}\n\nCancel back to the main menu.")
HOMM2_MESSAGE("table.gSpecialBuildingNames.0", "Fortifications")
HOMM2_MESSAGE("table.gSpecialBuildingNames.1", "Coliseum")
HOMM2_MESSAGE("table.gSpecialBuildingNames.2", "Rainbow")
HOMM2_MESSAGE("table.gSpecialBuildingNames.3", "Dungeon")
HOMM2_MESSAGE("table.gSpecialBuildingNames.4", "Library")
HOMM2_MESSAGE("table.gSpecialBuildingNames.5", "Storm")
HOMM2_MESSAGE("table.gSpecialBuildingNames.6", "Special")
HOMM2_MESSAGE("table.gSpellDesc.0", "{Fireball}\n\nCauses a giant fireball to strike the selected area, damaging all nearby creatures.")
HOMM2_MESSAGE("table.gSpellDesc.1", "{Fireblast}\n\nAn improved version of fireball, fireblast affects two hexes around the center point of the spell, rather than one.")
HOMM2_MESSAGE("table.gSpellDesc.10", "{Mass Haste}\n\nIncreases the speed of all of your creatures by two.")
HOMM2_MESSAGE("table.gSpellDesc.11", "{Slow}\n\nSlows target to half movement rate.")
HOMM2_MESSAGE("table.gSpellDesc.12", "{Mass Slow}\n\nSlows all enemies to half movement rate.")
HOMM2_MESSAGE("table.gSpellDesc.13", "{Blind }\n\nClouds the affected creatures' eyes, preventing them from moving.")
HOMM2_MESSAGE("table.gSpellDesc.14", "{Bless}\n\nCauses the selected creatures to inflict maximum damage.")
HOMM2_MESSAGE("table.gSpellDesc.15", "{Mass Bless}\n\nCauses all of your units to inflict maximum damage.")
HOMM2_MESSAGE("table.gSpellDesc.16", "{Stoneskin}\n\nMagically increases the defense skill of the selected creatures.")
HOMM2_MESSAGE("table.gSpellDesc.17", "{Steelskin}\n\nIncreases the defense skill of the targeted creatures.  This is an improved version of Stoneskin.")
HOMM2_MESSAGE("table.gSpellDesc.18", "{Curse}\n\nCauses the selected creatures to inflict minimum damage.")
HOMM2_MESSAGE("table.gSpellDesc.19", "{Mass Curse}\n\nCauses all enemy troops to inflict minimum damage.")
HOMM2_MESSAGE("table.gSpellDesc.2", "{Lightning Bolt}\n\nCauses a bolt of electrical energy to strike the selected creature.")
HOMM2_MESSAGE("table.gSpellDesc.20", "{Holy Word}\n\nDamages all undead in the battle.")
HOMM2_MESSAGE("table.gSpellDesc.21", "{Holy Shout}\n\nDamages all undead in the battle.  This is an improved version of Holy Word.")
HOMM2_MESSAGE("table.gSpellDesc.22", "{Anti-Magic}\n\nPrevents harmful magic against the selected creatures.")
HOMM2_MESSAGE("table.gSpellDesc.23", "{Dispel Magic}\n\nRemoves all magic spells from a single target.")
HOMM2_MESSAGE("table.gSpellDesc.24", "{Mass Dispel}\n\nRemoves all magic spells from all creatures.")
HOMM2_MESSAGE("table.gSpellDesc.25", "{Magic Arrow}\n\nCauses a magic arrow to strike the selected target.")
HOMM2_MESSAGE("table.gSpellDesc.26", "{Berzerker}\n\nCauses a creature to attack its nearest neighbor.")
HOMM2_MESSAGE("table.gSpellDesc.27", "{Armageddon}\n\nHoly terror strikes the battlefield, causing severe damage to all creatures.")
HOMM2_MESSAGE("table.gSpellDesc.28", "{Elemental Storm}\n\nMagical elements pour down on the battlefield, damaging all creatures.")
HOMM2_MESSAGE("table.gSpellDesc.29", "{Meteor Shower}\n\nA rain of rocks strikes an area of the battlefield, damaging all nearby creatures.")
HOMM2_MESSAGE("table.gSpellDesc.3", "{Chain Lightning}\n\nCauses a bolt of electrical energy to strike a selected creature, then strike the nearest creature with half damage, then strike the NEXT nearest creature with half again damage, and so on, until it becomes too weak to be harmful.  Warning:  This spell can hit your own creatures!")
HOMM2_MESSAGE("table.gSpellDesc.30", "{Paralyze}\n\nThe targeted creatures are paralyzed, unable to move or retaliate.")
HOMM2_MESSAGE("table.gSpellDesc.31", "{Hypnotize}\n\nBrings a single enemy unit under your control for one combat round if its hits are less than 25 times the caster's spell power.")
HOMM2_MESSAGE("table.gSpellDesc.32", "{Cold Ray}\n\nDrains body heat from a single enemy unit.")
HOMM2_MESSAGE("table.gSpellDesc.33", "{Cold Ring}\n\nDrains body heat from all units surrounding the center point, but not including the center point.")
HOMM2_MESSAGE("table.gSpellDesc.34", "{Disrupting Ray}\n\nReduces the defense rating of an enemy unit by three.")
HOMM2_MESSAGE("table.gSpellDesc.35", "{Death Ripple}\n\nDamages all living (non-undead) units in the battle.")
HOMM2_MESSAGE("table.gSpellDesc.36", "{Death Wave}\n\nDamages all living (non-undead) units in the battle.  This spell is an improved version of Death Ripple.")
HOMM2_MESSAGE("table.gSpellDesc.37", "{Dragon Slayer}\n\nGreatly increases a unit's attack skill vs. Dragons.")
HOMM2_MESSAGE("table.gSpellDesc.38", "{Blood Lust}\n\nIncreases a unit's attack skill.")
HOMM2_MESSAGE("table.gSpellDesc.39", "{Animate Dead}\n\n'Resurrects' creatures from a damaged or dead undead unit permanently.")
HOMM2_MESSAGE("table.gSpellDesc.4", "{Teleport}\n\nTeleports the creature you select to any open position on the battlefield.")
HOMM2_MESSAGE("table.gSpellDesc.40", "{Mirror Image}\n\nCreates an illusionary unit that duplicates one of your existing units.  This illusionary unit does the same damages as the original, but will vanish if it takes any damage.")
HOMM2_MESSAGE("table.gSpellDesc.41", "{Shield}\n\nHalves damage received from ranged attacks for a single unit.")
HOMM2_MESSAGE("table.gSpellDesc.42", "{Mass Shield}\n\nHalves damage received from ranged attacks for all of your units.")
HOMM2_MESSAGE("table.gSpellDesc.43", "{Summon Earth Elemental}\n\nSummons Earth Elementals to fight for your army.")
HOMM2_MESSAGE("table.gSpellDesc.44", "{Summon Air Elemental}\n\nSummons Air Elementals to fight for your army.")
HOMM2_MESSAGE("table.gSpellDesc.45", "{Summon Fire Elemental}\n\nSummons Fire Elementals to fight for your army.")
HOMM2_MESSAGE("table.gSpellDesc.46", "{Summon Water Elemental}\n\nSummons Water Elementals to fight for your army.")
HOMM2_MESSAGE("table.gSpellDesc.47", "{Earthquake}\n\nDamages castle walls.")
HOMM2_MESSAGE("table.gSpellDesc.48", "{View Mines}\n\nCauses all mines across the land to become visible.")
HOMM2_MESSAGE("table.gSpellDesc.49", "{View Resources}\n\nCauses all resources across the land to become visible.")
HOMM2_MESSAGE("table.gSpellDesc.5", "{Cure}\n\nRemoves all negative spells cast upon one of your units, and restores up to 5 HP per level of spell power.")
HOMM2_MESSAGE("table.gSpellDesc.50", "{View Artifacts}\n\nCauses all artifacts across the land to become visible.")
HOMM2_MESSAGE("table.gSpellDesc.51", "{View Towns}\n\nCauses all towns and castles across the land to become visible.")
HOMM2_MESSAGE("table.gSpellDesc.52", "{View Heroes}\n\nCauses all Heroes across the land to become visible.")
HOMM2_MESSAGE("table.gSpellDesc.53", "{View All}\n\nCauses the entire land to become visible.")
HOMM2_MESSAGE("table.gSpellDesc.54", "{Identify Hero}\n\nAllows the caster to view detailed information on enemy Heroes.")
HOMM2_MESSAGE("table.gSpellDesc.55", "{Summon Boat}\n\nSummons the nearest unoccupied, friendly boat to an adjacent shore location.  A friendly boat is one which you just built or were the most recent player to occupy.")
HOMM2_MESSAGE("table.gSpellDesc.56", "{Dimension Door}\n\nAllows the caster to magically transport to a nearby location.")
HOMM2_MESSAGE("table.gSpellDesc.57", "{Town Gate}\n\nReturns the caster to any town or castle currently owned.")
HOMM2_MESSAGE("table.gSpellDesc.58", "{Town Portal}\n\nReturns the hero to the town or castle of choice, provided it is controlled by you.")
HOMM2_MESSAGE("table.gSpellDesc.59", "{Visions}\n\n Visions predicts the likely outcome of an encounter with a neutral army camp.")
HOMM2_MESSAGE("table.gSpellDesc.6", "{Mass Cure}\n\nRemoves all negative spells cast upon your forces, and restores up to 5 HP per level of spell power, per creature.")
HOMM2_MESSAGE("table.gSpellDesc.60", "{Haunt}\n\nHaunts a mine you control with Ghosts.  This mine stops producing resources.  (If I can't keep it, nobody will!)")
HOMM2_MESSAGE("table.gSpellDesc.61", "{Set Earth Guardian}\n\nSets Earth Elementals to guard a mine against enemy armies.")
HOMM2_MESSAGE("table.gSpellDesc.62", "{Set Air Guardian}\n\nSets Air Elementals to guard a mine against enemy armies.")
HOMM2_MESSAGE("table.gSpellDesc.63", "{Set Fire Guardian}\n\nSets Fire Elementals to guard a mine against enemy armies.")
HOMM2_MESSAGE("table.gSpellDesc.64", "{Set Water Guardian}\n\nSets Water Elementals to guard a mine against enemy armies.")
HOMM2_MESSAGE("table.gSpellDesc.7", "{Resurrect}\n\nResurrects creatures from a damaged or dead unit until end of combat.")
HOMM2_MESSAGE("table.gSpellDesc.8", "{Resurrect True}\n\nResurrects creatures from a damaged or dead unit permanently.")
HOMM2_MESSAGE("table.gSpellDesc.9", "{Haste}\n\nIncreases the speed of any creature by two.")
