HOMM2_MESSAGE("table.gArtifactNames.100", "Sword Breaker")
HOMM2_MESSAGE("table.gArtifactNames.101", "Sword of Anduran")
HOMM2_MESSAGE("table.gArtifactNames.102", "Spade of Necromancy")
