HOMM2_MESSAGE("table.xSetupCampaignGameHelp.0", "{Original Campaign}\n\nEither Roland's or Archibald's campaign from the original Heroes of Might and Magic II.")
HOMM2_MESSAGE("table.xSetupCampaignGameHelp.1", "{Expansion Campaign}\n\nOne of the four new campaigns from the Price of Loyalty expansion set.")
HOMM2_MESSAGE("table.xSetupCampaignGameHelp.2", "{Cancel}\n\nCancel back to the main menu.")
