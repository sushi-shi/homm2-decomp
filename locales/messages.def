HOMM2_MESSAGE("table.gArtifactDesc.0", "{Ultimate Book\n(+12 Knowledge)}\n\nThe Ultimate Book of Knowledge increases your knowledge by 12.")
HOMM2_MESSAGE("table.gArtifactDesc.1", "{Ultimate Sword\n(+12 Attack)}\n\nThe Ultimate Sword of Dominion increases your attack skill by 12.")
HOMM2_MESSAGE("table.gArtifactDesc.10", "{Mage's Ring\n(+2 Spell Power)}\n\nThe Mage's Ring of Power increases your spell power by 2.")
HOMM2_MESSAGE("table.gArtifactDesc.100", "{Sword Breaker}\n\nThe Sword Breaker increases your defense by 4 and attack by 1.")
HOMM2_MESSAGE("table.gArtifactDesc.101", "{Sword of Anduran}\n\nThe Sword increases your attack skill by 5.")
HOMM2_MESSAGE("table.gArtifactDesc.102", "{Spade of Necromancy}\n\nThe Spade gives you increased necromancy skill.")
HOMM2_MESSAGE("table.gArtifactDesc.11", "{Witches Broach\n(+3 Spell Power)}\n\nThe Witch's Broach of Magic increases your spell power by 3.")
HOMM2_MESSAGE("table.gArtifactDesc.12", "{Medal}\n\nThe Medal of Valor increases your morale.")
HOMM2_MESSAGE("table.gArtifactDesc.13", "{Medal}\n\nThe Medal of Courage increases your morale.")
HOMM2_MESSAGE("table.gArtifactDesc.14", "{Medal}\n\nThe Medal of Honor increases your morale.")
HOMM2_MESSAGE("table.gArtifactDesc.15", "{Medal}\n\nThe Medal of Distinction increases your morale.")
HOMM2_MESSAGE("table.gArtifactDesc.16", "{Fizbin}\n\nThe Fizbin of Misfortune greatly decreases your morale.")
HOMM2_MESSAGE("table.gArtifactDesc.17", "{Thunder Mace\n(+1 Attack)}\n\nThe Thunder Mace of Dominion increases your attack skill by 1.")
HOMM2_MESSAGE("table.gArtifactDesc.18", "{Armored Gauntlets\n(+1 Defense)}\n\nThe Armored Gauntlets of Protection increase your defense skill by 1.")
HOMM2_MESSAGE("table.gArtifactDesc.19", "{Defender Helm\n(+1 Defense)}\n\nThe Defender Helm of Protection increases your defense skill by 1.")
HOMM2_MESSAGE("table.gArtifactDesc.2", "{Ultimate Cloak\n(+12 Defense)}\n\nThe Ultimate Cloak of Protection increases your defense skill by 12.")
HOMM2_MESSAGE("table.gArtifactDesc.20", "{Giant Flail\n(+1 Attack)}\n\nThe Giant Flail of Dominion increases your attack skill by 1.")
HOMM2_MESSAGE("table.gArtifactDesc.21", "{Ballista}\n\nThe Ballista of Quickness lets your catapult fire twice per combat round.")
HOMM2_MESSAGE("table.gArtifactDesc.22", "{Stealth Shield\n(+2 Defense)}\n\nThe Stealth Shield of Protection increases your defense skill by 2.")
HOMM2_MESSAGE("table.gArtifactDesc.23", "{Dragon Sword\n(+3 Attack)}\n\nThe Dragon Sword of Dominion increases your attack skill by 3.")
HOMM2_MESSAGE("table.gArtifactDesc.24", "{Power Axe\n(+2 Attack)}\n\nThe Power Axe of Dominion increases your attack skill by 2.")
HOMM2_MESSAGE("table.gArtifactDesc.25", "{Divine Breastplate\n(+3 Defense)}\n\nThe Divine Breastplate of Protection increases your defense skill by 3.")
HOMM2_MESSAGE("table.gArtifactDesc.26", "{Minor Scroll\n(+2 Knowledge)}\n\nThe Minor Scroll of Knowledge increases your knowledge by 2.")
HOMM2_MESSAGE("table.gArtifactDesc.27", "{Major Scroll\n(+3 Knowledge)}\n\nThe Major Scroll of Knowledge increases your knowledge by 3.")
HOMM2_MESSAGE("table.gArtifactDesc.28", "{Superior Scroll\n(+4 Knowledge)}\n\nThe Superior Scroll of Knowledge increases your knowledge by 4.")
HOMM2_MESSAGE("table.gArtifactDesc.29", "{Foremost Scroll\n(+5 Knowledge)}\n\nThe Foremost Scroll of Knowledge increases your knowledge by 5.")
HOMM2_MESSAGE("table.gArtifactDesc.3", "{Ultimate Wand\n(+12 Spell Power)}\n\nThe Ultimate Wand of Magic increases your spell power by 12.")
HOMM2_MESSAGE("table.gArtifactDesc.30", "{Endless Sack}\n\nThe Endless Sack of Gold provides you with 1000 gold per day.")
HOMM2_MESSAGE("table.gArtifactDesc.31", "{Endless Bag}\n\nThe Endless Bag of Gold provides you with 750 gold per day.")
HOMM2_MESSAGE("table.gArtifactDesc.32", "{Endless Purse}\n\nThe Endless Purse of Gold provides you with 500 gold per day.")
HOMM2_MESSAGE("table.gArtifactDesc.33", "{Nomad Boots}\n\nThe Nomad Boots of Mobility increase your movement on land.")
HOMM2_MESSAGE("table.gArtifactDesc.34", "{Traveler's Boots}\n\nThe Traveler's Boots of Mobility increase your movement on land.")
HOMM2_MESSAGE("table.gArtifactDesc.35", "{Rabbit's Foot}\n\nThe Lucky Rabbit's Foot increases your luck in combat.")
HOMM2_MESSAGE("table.gArtifactDesc.36", "{Horseshoe}\n\nThe Golden Horseshoe increases your luck in combat.")
HOMM2_MESSAGE("table.gArtifactDesc.37", "{Coin}\n\nThe Gambler's Lucky Coin increases your luck in combat.")
HOMM2_MESSAGE("table.gArtifactDesc.38", "{Clover}\n\nThe Four-Leaf Clover increases your luck in combat.")
HOMM2_MESSAGE("table.gArtifactDesc.39", "{Compass}\n\nThe True Compass of Mobility increases your movement on land and sea.")
HOMM2_MESSAGE("table.gArtifactDesc.4", "{Ultimate Shield}\n\nThe Ultimate Shield increases your attack and defense skills by 6 each.")
HOMM2_MESSAGE("table.gArtifactDesc.40", "{Astrolabe}\n\nThe Sailors' Astrolabe of Mobility increases your movement on sea.")
HOMM2_MESSAGE("table.gArtifactDesc.41", "{Evil Eye}\n\nThe Evil Eye reduces the casting cost of curse spells by half.")
HOMM2_MESSAGE("table.gArtifactDesc.42", "{Enchanted hourglass}\n\nThe Enchanted Hourglass extends the duration of all your spells by 2 turns.")
HOMM2_MESSAGE("table.gArtifactDesc.43", "{Gold watch}\n\nThe Gold Watch doubles the effectiveness of your hypnotize spells.")
HOMM2_MESSAGE("table.gArtifactDesc.44", "{Skullcap}\n\nThe Skullcap halves the casting cost of all mind influencing spells.")
HOMM2_MESSAGE("table.gArtifactDesc.45", "{Ice cloak}\n\nThe Ice Cloak halves all damage your troops take from cold spells.")
HOMM2_MESSAGE("table.gArtifactDesc.46", "{Fire cloak}\n\nThe Fire Cloak halves all damage your troops take from fire spells.")
HOMM2_MESSAGE("table.gArtifactDesc.47", "{Lightning helm}\n\nThe Lightning Helm halves all damage your troops take from lightning spells.")
HOMM2_MESSAGE("table.gArtifactDesc.48", "{Evercold icicle}\n\nThe Evercold Icicle causes your cold spells to do 50% more damage to enemy troops.")
HOMM2_MESSAGE("table.gArtifactDesc.49", "{Everhot lava rock}\n\nThe Everhot Lava Rock causes your fire spells to do 50% more damage to enemy troops.")
HOMM2_MESSAGE("table.gArtifactDesc.5", "{Ultimate Staff}\n\nThe Ultimate Staff increases your spell power and knowledge by 6 each.")
HOMM2_MESSAGE("table.gArtifactDesc.50", "{Lightning rod }\n\nThe Lightning Rod causes your lightning spells to do 50% more damage to enemy troops.")
HOMM2_MESSAGE("table.gArtifactDesc.51", "{Snake-ring}\n\nThe Snake Ring halves the casting cost of all your bless spells.")
HOMM2_MESSAGE("table.gArtifactDesc.52", "{Ankh}\n\nThe Ankh doubles the effectiveness of all your resurrect and animate spells.")
HOMM2_MESSAGE("table.gArtifactDesc.53", "{Book of Elements}\n\nThe Book of Elements doubles the effectiveness of all your summoning spells.")
HOMM2_MESSAGE("table.gArtifactDesc.54", "{Elemental ring}\n\nThe Elemental Ring halves the casting cost of all summoning spells.")
HOMM2_MESSAGE("table.gArtifactDesc.55", "{Holy Pendant}\n\nThe Holy Pendant makes all your troops immune to curse spells.")
HOMM2_MESSAGE("table.gArtifactDesc.56", "{Pendant of free will}\n\nThe Pendant of Free Will makes all your troops immune to hypnotize spells.")
HOMM2_MESSAGE("table.gArtifactDesc.57", "{Pendant of life}\n\nThe Pendant of Life makes all your troops immune to death spells.")
HOMM2_MESSAGE("table.gArtifactDesc.58", "{Serenity pendant}\n\nThe Serenity Pendant makes all your troops immune to berserk spells.")
HOMM2_MESSAGE("table.gArtifactDesc.59", "{Seeing-eye pendant}\n\nThe Seeing-eye Pendant makes all your troops immune to blindness spells.")
HOMM2_MESSAGE("table.gArtifactDesc.6", "{Ultimate Crown}\n\nThe Ultimate Crown increases each of your basic skills by 4 points.")
HOMM2_MESSAGE("table.gArtifactDesc.60", "{Kinetic pendant}\n\nThe Kinetic Pendant makes all your troops immune to paralyze spells.")
HOMM2_MESSAGE("table.gArtifactDesc.61", "{Pendant of death}\n\nThe Pendant of Death makes all your troops immune to holy spells.")
HOMM2_MESSAGE("table.gArtifactDesc.62", "{Wand of negation}\n\nThe Wand of Negation protects your troops from the Dispel Magic spell.")
HOMM2_MESSAGE("table.gArtifactDesc.63", "{Golden bow}\n\nThe Golden Bow eliminates the 50% penalty for your troops shooting past obstacles. (e.g. castle walls)")
HOMM2_MESSAGE("table.gArtifactDesc.64", "{Telescope}\n\nThe Telescope increases the amount of terrain your hero reveals when adventuring by 1 extra square.")
HOMM2_MESSAGE("table.gArtifactDesc.65", "{Statesman's quill}\n\nThe Statesman's Quill reduces the cost of surrender to 10% of the total cost of troops you have in your army.")
HOMM2_MESSAGE("table.gArtifactDesc.66", "{Wizard's hat}\n\nThe Wizard's Hat increases the duration of your spells by 10 turns!")
HOMM2_MESSAGE("table.gArtifactDesc.67", "{Power ring}\n\nThe Power Ring returns 2 extra spell points/turn to your hero.")
HOMM2_MESSAGE("table.gArtifactDesc.68", "{Ammo cart}\n\nThe Ammo Cart provides endless ammunition for all your troops that shoot.")
HOMM2_MESSAGE("table.gArtifactDesc.69", "{Tax lien}\n\nThe Tax Lien costs you 250 gold pieces/turn.")
HOMM2_MESSAGE("table.gArtifactDesc.7", "{Golden Goose}\n\nThe Golden Goose brings in an income of 10,000 gold per turn.")
HOMM2_MESSAGE("table.gArtifactDesc.70", "{Hideous mask}\n\nThe Hideous Mask prevents all 'wandering' armies from joining your hero.")
HOMM2_MESSAGE("table.gArtifactDesc.71", "{Endless pouch of sulfur}\n\nThe Endless Pouch of Sulfur provides 1 unit of sulfur per day.")
HOMM2_MESSAGE("table.gArtifactDesc.72", "{Endless vial of mercury}\n\nThe Endless Vial of Mercury provides 1 unit of mercury per day.")
HOMM2_MESSAGE("table.gArtifactDesc.73", "{Endless pouch of gems}\n\nThe Endless Pouch of Gems provides 1 unit of gems per day.")
HOMM2_MESSAGE("table.gArtifactDesc.74", "{Endless cord of wood}\n\nThe Endless Cord of Wood provides 1 unit of wood per day.")
HOMM2_MESSAGE("table.gArtifactDesc.75", "{Endless cart of ore}\n\nThe Endless Cart of Ore provides 1 unit of ore per day.")
HOMM2_MESSAGE("table.gArtifactDesc.76", "{Endless pouch of crystal}\n\nThe Endless Pouch of Crystal provides 1 unit of crystal/day.")
HOMM2_MESSAGE("table.gArtifactDesc.77", "{Spiked helm}\n\nThe Spiked Helm increases your attack and defense skills by 1 each.")
HOMM2_MESSAGE("table.gArtifactDesc.78", "{Spiked shield}\n\nThe Spiked Shield increases your attack and defense skills by 2 each.")
HOMM2_MESSAGE("table.gArtifactDesc.79", "{White pearl}\n\nThe White Pearl increases your spell power and knowledge by 1 each.")
HOMM2_MESSAGE("table.gArtifactDesc.8", "{Arcane Necklace\n(+4 Spell Power)}\n\nThe Arcane Necklace of Magic increases your spell power by 4.")
HOMM2_MESSAGE("table.gArtifactDesc.80", "{Black pearl}\n\nThe Black Pearl increases your spell power and knowledge by 2 each.")
HOMM2_MESSAGE("table.gArtifactDesc.81", "{Magic Book}\n\nThe Magic Book enables you to cast spells.")
HOMM2_MESSAGE("table.gArtifactDesc.86", "{Spell Scroll}\n\nThis Spell Scroll gives your hero the ability to cast the '%s' spell.")
HOMM2_MESSAGE("table.gArtifactDesc.87", "{Arm of the Martyr}\n\nThe Arm of the Martyr increases your spell power by 3 but adds the undead morale penalty.")
HOMM2_MESSAGE("table.gArtifactDesc.88", "{Breastplate of Anduran}\n\nThe Breastplate increases your defense by 5.")
HOMM2_MESSAGE("table.gArtifactDesc.89", "{Broach of Shielding}\n\nThe Broach of Shielding provides 50% protection from Armageddon and Elemental Storm, but decreases spell power by 2.")
HOMM2_MESSAGE("table.gArtifactDesc.9", "{Caster's Bracelet\n(+2 Spell Power)}\n\nThe Caster's Bracelet of Magic increases your spell power by 2.")
HOMM2_MESSAGE("table.gArtifactDesc.90", "{Battle Garb}\n\nThe Battle Garb of Anduran combines the powers of the three Anduran artifacts.  It provides maximum luck and morale for your troops and gives you the Town Portal spell.")
HOMM2_MESSAGE("table.gArtifactDesc.91", "{Crystal Ball}\n\nThe Crystal Ball lets you get more specific information about monsters, enemy heroes, and castles nearby the hero who holds it.")
HOMM2_MESSAGE("table.gArtifactDesc.92", "{Heart of Fire}\n\nThe Heart of Fire provides 50% protection from fire, but doubles the damage taken from cold.")
HOMM2_MESSAGE("table.gArtifactDesc.93", "{Heart of Ice}\n\nThe Heart of Ice provides 50% protection from cold, but doubles the damage taken from fire.")
HOMM2_MESSAGE("table.gArtifactDesc.94", "{Helmet of Anduran}\n\nThe Helmet increases your spell power by 5.")
HOMM2_MESSAGE("table.gArtifactDesc.95", "{Holy Hammer}\n\nThe Holy Hammer increases your attack skill by 5.")
HOMM2_MESSAGE("table.gArtifactDesc.96", "{Legendary Scepter}\n\nThe Legendary Scepter adds 2 points to all attributes.")
HOMM2_MESSAGE("table.gArtifactDesc.97", "{Masthead}\n\nThe Masthead boosts your luck and morale by 1 each in sea combat.")
HOMM2_MESSAGE("table.gArtifactDesc.98", "{Sphere of Negation}\n\nThe Sphere of Negation disables all spell casting, for both sides, in combat.")
HOMM2_MESSAGE("table.gArtifactDesc.99", "{Staff of Wizardry}\n\nThe Staff of Wizardry boosts your spell power by 5.")
HOMM2_MESSAGE("table.gArtifactEvent.10", "A cry of pain leads you to a Centaur, caught in a trap.  Upon setting the creature free, he hands you a small pouch.  Emptying the contents, you find a dazzling jeweled ring.")
HOMM2_MESSAGE("table.gArtifactEvent.100", "A former Captain of the Guard admires your quest and gives you the enchanted Sword Breaker that he relied on during his tour of duty.")
HOMM2_MESSAGE("table.gArtifactEvent.101", "A Troll stops you and says: \"Pay me 5,000 gold, or the Sword of Anduran will slay you where you stand.\"  You refuse.  The troll grabs the sword hanging from its belt, screams in pain, and runs away.  Picking up the fabled sword, you give thanks that half-witted Trolls tend to grab the wrong end of sharp objects.")
HOMM2_MESSAGE("table.gArtifactEvent.102", "A dirty shovel has been thrust into a dirt mound nearby. Upon investigation, you discover it to be the enchanted shovel of the Gravediggers, long thought lost by mortals.")
HOMM2_MESSAGE("table.gArtifactEvent.11", "Alongside the remains of a burnt witch lies a beautiful broach, intricately designed.  Approaching the corpse with caution, you add the broach to your inventory.")
HOMM2_MESSAGE("table.gArtifactEvent.12", "Freeing a virtuous maiden from the clutches of an evil overlord, you are granted a Medal of Valor by the King's herald.")
HOMM2_MESSAGE("table.gArtifactEvent.13", "After saving a young boy from a vicious pack of Wolves, you return him to his father's manor.  The grateful nobleman awards you with a Medal of Courage.")
HOMM2_MESSAGE("table.gArtifactEvent.14", "After freeing a princess of a neighboring kingdom from the evil clutches of despicable slavers, she awards you with a Medal of Honor.")
HOMM2_MESSAGE("table.gArtifactEvent.15", "Ridding the countryside of the hideous Minotaur who made a sport of eating noblemen's Knights, you are honored with the Medal of Distinction.")
HOMM2_MESSAGE("table.gArtifactEvent.16", "You stumble upon a medal lying alongside the empty road.  Adding the medal to your inventory, you become aware that you have acquired the undesirable Fizbin of Misfortune, greatly decreasing your army's morale.")
HOMM2_MESSAGE("table.gArtifactEvent.17", "During a sudden storm, a bolt of lightning strikes a tree, splitting it.  Inside the tree you find a mysterious mace.")
HOMM2_MESSAGE("table.gArtifactEvent.18", "You encounter the infamous Black Knight!  After a grueling duel ending in a draw, the Knight, out of respect, offers you a pair of armored gauntlets.")
HOMM2_MESSAGE("table.gArtifactEvent.19", "A glint of golden light catches your eye.  Upon further investigation, you find a golden helm hidden under a bush.")
HOMM2_MESSAGE("table.gArtifactEvent.20", "A clumsy Giant has killed himself with his own flail.  Knowing your superior skill with this weapon, you confidently remove the spectacular flail from the fallen Giant.")
HOMM2_MESSAGE("table.gArtifactEvent.21", "Walking through the ruins of an ancient walled city, you find the instrument of the city's destruction, an elaborately crafted ballista.")
HOMM2_MESSAGE("table.gArtifactEvent.22", "A stone statue of a warrior holds a silver shield.  As you remove the shield, the statue crumbles into dust.")
HOMM2_MESSAGE("table.gArtifactEvent.23", "As you are walking along a narrow path, a nearby bush suddenly bursts into flames.  Before your eyes the flames become the image of a beautiful woman.  She holds out a magnificent sword to you.")
HOMM2_MESSAGE("table.gArtifactEvent.24", "You see a silver axe embedded deeply in the ground.  After several unsuccessful attempts by your army to remove the axe, you tightly grip the handle of the axe and effortlessly pull it free.")
HOMM2_MESSAGE("table.gArtifactEvent.25", "A gang of Rogues is sifting through the possessions of dead warriors.  Scaring off the scavengers, you note the Rogues had overlooked a beautiful breastplate.")
HOMM2_MESSAGE("table.gArtifactEvent.26", "Before you appears a levitating glass case with a scroll, perched upon a bed of crimson velvet.  At your touch, the lid opens and the scroll floats into your awaiting hands.")
HOMM2_MESSAGE("table.gArtifactEvent.27", "Visiting a local wiseman, you explain the intent of your journey.  He reaches into a sack and withdraws a yellowed scroll and hands it to you.")
HOMM2_MESSAGE("table.gArtifactEvent.28", "You come across the remains of an ancient Druid.  Bones, yellowed with age, peer from the ragged folds of her robe.  Searching the robe, you discover a scroll hidden in the folds.")
HOMM2_MESSAGE("table.gArtifactEvent.29", "Mangled bones, yellowed with age, peer from the ragged folds of a dead Druid's robe.  Searching the robe, you discover a scroll hidden within.")
HOMM2_MESSAGE("table.gArtifactEvent.30", "A little leprechaun dances gleefully around a magic sack.  Seeing you approach, he stops in mid-stride.  The little man screams and stamps his foot ferociously, vanishing into thin air.  Remembering the old leprechaun saying 'Finders Keepers', you grab the sack and leave.")
HOMM2_MESSAGE("table.gArtifactEvent.31", "A noblewoman, separated from her traveling companions, asks for your help.  After escorting her home, she rewards you with a bag filled with gold.")
HOMM2_MESSAGE("table.gArtifactEvent.32", "In your travels, you find a leather purse filled with gold that once belonged to a great warrior king who had the ability to transform any inanimate object into gold.")
HOMM2_MESSAGE("table.gArtifactEvent.33", "A Nomad trader seeks protection from a tribe of Goblins.  For your assistance, he gives you a finely crafted pair of boots made from the softest leather.  Looking closely, you see fascinating ancient carvings engraved on the leather.")
HOMM2_MESSAGE("table.gArtifactEvent.34", "Discovering a pair of beautifully beaded boots made from the finest and softest leather, you thank the anonymous donor and add the boots to your inventory.")
HOMM2_MESSAGE("table.gArtifactEvent.35", "A traveling merchant offers you a rabbit's foot, made of gleaming silver fur, for safe passage.  The merchant explains the charm will increase your luck in combat.")
HOMM2_MESSAGE("table.gArtifactEvent.36", "An ensnared Unicorn whinnies in fright.  Murmuring soothing words, you set her free.  Snorting and stamping her front hoof once, she gallops off.  Looking down you see a golden horseshoe.")
HOMM2_MESSAGE("table.gArtifactEvent.37", "You have captured a mischievous imp who has been terrorizing the region.  In exchange for his release, he rewards you with a magical coin.")
HOMM2_MESSAGE("table.gArtifactEvent.38", "In the middle of a patch of dead and dry vegetation, to your surprise you find a healthy green four-leaf clover.")
HOMM2_MESSAGE("table.gArtifactEvent.39", "An old man claiming to be an inventor asks you to try his latest invention.  He then hands you a compass.")
HOMM2_MESSAGE("table.gArtifactEvent.40", "An old sea captain is being tortured by Ogres.  You save him, and in return he rewards you with a wondrous instrument to measure the distance of a star.")
HOMM2_MESSAGE("table.gArtifactEvent.41", "While venturing into a decrepit hut you find the Skeleton of a long dead witch.  Investigation of the remains reveals a glass eye rolling around inside an empty skull.")
HOMM2_MESSAGE("table.gArtifactEvent.42", "A surprise turn in the landscape finds you in the midst of a grisly scene:  Vultures picking at the aftermath of a terrible battle.  Your cursory search of the remains turns up an enchanted hourglass.")
HOMM2_MESSAGE("table.gArtifactEvent.43", "In reward for helping his cart out of a ditch, a traveling potion salesman gives you a \"magic\" gold watch.  Unbeknownst to him, the watch really is magical.")
HOMM2_MESSAGE("table.gArtifactEvent.44", "A brief stop at an improbable rural inn yields an exchange of money, tales, and accidentally, luggage.  You find a magical skullcap in your new backpack.")
HOMM2_MESSAGE("table.gArtifactEvent.45", "Responding to the panicked cries of a damsel in distress, you discover a young woman fleeing from a hungry bear.  You slay the beast in the nick of time, and the grateful Sorceress weaves a magic cloak from the bear's hide.")
HOMM2_MESSAGE("table.gArtifactEvent.46", "You've come upon a fight between a Necromancer and a Paladin.  The Necromancer blasts the Paladin with a fire bolt, bringing him to his knees.  Acting quickly, you slay the evil one before the final blow.  The grateful Paladin gives you the fire cloak that saved him.")
HOMM2_MESSAGE("table.gArtifactEvent.47", "A traveling tinker in need of supplies offers you a helm with a thunderbolt design on its top in exchange for food and water.  Curious, you accept, and later find out that the helm is magical.")
HOMM2_MESSAGE("table.gArtifactEvent.48", "An icicle withstanding the full heat of the noonday sun attracts your attention.  Intrigued, you break it off, and find that it does not melt in your hand.")
HOMM2_MESSAGE("table.gArtifactEvent.49", "Your wanderings bring you into contact with a tribe of ape-like beings using a magical lava rock that never cools to light their fires.  You take pity on them and teach them to make fire with sticks.  Believing you to be a god, the apes give you their rock.")
HOMM2_MESSAGE("table.gArtifactEvent.50", "While waiting out a storm, a lighting bolt strikes a nearby cottage's lightning rod, which melts and falls to the ground.  The tip of the rod, however, survives intact and makes your hair stand on end when you touch it.  Hmm...")
HOMM2_MESSAGE("table.gArtifactEvent.51", "You've found an oddly shaped ring on the finger of a long dead traveler.  The ring looks like a snake biting its own tail.")
HOMM2_MESSAGE("table.gArtifactEvent.52", "A fierce windstorm reveals the entrance to a buried tomb.  Your investigation reveals that the tomb has already been looted, but the thieves overlooked an ankh on a silver chain in the dark.")
HOMM2_MESSAGE("table.gArtifactEvent.53", "You come across a conjurer who begs to accompany you and your army awhile for safety.  You agree, and he offers as payment a copy of the book of the elements.")
HOMM2_MESSAGE("table.gArtifactEvent.54", "While pausing to rest, you notice a bobcat climbing a short tree to get at a crow's nest.  On impulse, you climb the tree yourself and scare off the cat.  When you look in the nest, you find a collection of shiny stones and a ring.")
HOMM2_MESSAGE("table.gArtifactEvent.55", "In your wanderings you come across a hermit living in a small, tidy hut.  Impressed with your mission, he takes time out from his meditations to bless and give you a charm against curses.")
HOMM2_MESSAGE("table.gArtifactEvent.56", "Responding to cries for help, you find river Sprites making a sport of dunking an old man.  Feeling vengeful, you rescue the man and drag a Sprite onto dry land for awhile.  The Sprite, uncomfortable in the air, gives you a magic pendant to let him go.")
HOMM2_MESSAGE("table.gArtifactEvent.57", "A brief roadside encounter with a small caravan and a game of knucklebones wins a magic pendant.  Its former owner says that it protects from Necromancers' death spells.")
HOMM2_MESSAGE("table.gArtifactEvent.58", "The sounds of combat draw you to the scene of a fight between an old Barbarian and an eight-headed Hydra.  Your timely intervention swings the battle in favor of the man, and he rewards you with a pendant he used to use to calm his mind for battle.")
HOMM2_MESSAGE("table.gArtifactEvent.59", "You come upon a very old woman, long blind from cataracts and dying alone.  You tend to her final needs and promise a proper burial.  Grateful, she gives you a magic pendant emblazoned with a stylized eye.  It lets you see with your eyes closed.")
HOMM2_MESSAGE("table.gArtifactEvent.60", "You come across a golem wearing a glowing pendant and blocking your way.   Acting on a hunch, you cut the pendant from its neck.  Deprived of its power source, the golem breaks down, leaving you with the magical pendant.")
HOMM2_MESSAGE("table.gArtifactEvent.61", "A quick and deadly battle with a Necromancer wins you his magical pendant.  Later, a Wizard tells you that the pendant protects undead under your control from holy word spells.")
HOMM2_MESSAGE("table.gArtifactEvent.62", "You meet an old Wizard friend of yours traveling in the opposite direction.  He presents  you with a gift:  A wand that prevents the use of the dispel magic spell on your allies.")
HOMM2_MESSAGE("table.gArtifactEvent.63", "A chance meeting with a famous Archer finds you in a game of knucklebones pitting his bow against your horse.  You win.")
HOMM2_MESSAGE("table.gArtifactEvent.64", "A merchant from far away lands trades you a new invention of his people for traveling supplies.  It makes distant objects appear closer, and he calls it...\n\na telescope.")
HOMM2_MESSAGE("table.gArtifactEvent.65", "You pause to help a diplomat with a broken axle fix his problem.  In gratitude, he gives you a writing quill with magical properties which he says will \"help people see things your way\".")
HOMM2_MESSAGE("table.gArtifactEvent.66", "You see a Wizard fleeing from a Griffin and riding like the wind.  The Wizard opens a portal and rides through, getting his hat knocked off by the edge of the gate.  The Griffin follows; the gate closes.  You pick the hat up, dust it off, and put it on.")
HOMM2_MESSAGE("table.gArtifactEvent.67", "You find a small tree that closely resembles the great Warlock Carnauth with a ring around one of its twigs.  Scraps of clothing and rotting leather lead you to suspect that it IS Carnauth, transformed.  Since you can't help him, you take the magic ring.")
HOMM2_MESSAGE("table.gArtifactEvent.68", "An ammunition cart in the middle of an old battlefield catches your eye.  Inspection shows it to be in good working order, so  you take it along.")
HOMM2_MESSAGE("table.gArtifactEvent.69", "Your big spending habits have earned you a massive tax bill that you can't hope to pay.  The tax man takes pity and agrees to only take 250 gold a day from your account for life.  Check here if you want one dollar to go to the presidential campaign election fund.")
HOMM2_MESSAGE("table.gArtifactEvent.70", "Your looting of the grave of Sinfilas Gardolad, the famous shapeshifting Warlock, unearths his fabled mask.  Trembling, you put it on and it twists your visage into an awful grimace!  Oh no!  It's actually the hideous mask of Gromluck Greene, and you are stuck with it.")
HOMM2_MESSAGE("table.gArtifactEvent.71", "You visit an alchemist who, upon seeing your army, is swayed by the righteousness of your cause.  The newly loyal subject gives you his endless pouch of sulfur to help with the war effort.")
HOMM2_MESSAGE("table.gArtifactEvent.72", "A brief stop at a hastily abandoned Wizard's tower turns up a magical vial of mercury that always has a little left on the bottom.  Recognizing a treasure when you see one, you cap it and slip it in your pocket.")
HOMM2_MESSAGE("table.gArtifactEvent.73", "A short rainstorm brings forth a rainbow...and you can see the end of it.  Riding quickly, you seize the pot of gold you find there.  The leprechaun who owns it, unable to stop you from taking it, offers an endless pouch of gems for the return of his gold.  You accept.")
HOMM2_MESSAGE("table.gArtifactEvent.74", "Pausing to rest and light a cook fire, you pull wood out of a nearby pile of dead wood.  As you keep pulling wood from the pile, you notice that it doesn't shrink.  You realize to your delight that the wood is enchanted, so you take it along.")
HOMM2_MESSAGE("table.gArtifactEvent.75", "You've found a Goblin weapon smithy making weapons for use against humans.  With a tremendous yell you and your army descend upon their camp and drive them away.  A search finds a magic ore cart that never runs out of iron.")
HOMM2_MESSAGE("table.gArtifactEvent.76", "Taking shelter from a storm in a small cave,  you notice a small patch of crystal in one corner.  Curious, you break a piece off and notice that the original crystal grows the lost piece back.  You decide to stuff the entire patch into a pouch and take it with you.")
HOMM2_MESSAGE("table.gArtifactEvent.77", "Your army is ambushed by a small tribe of wild (and none too bright) Orcs.  You fend them off easily and the survivors flee in all directions.  One of the Orcs was wearing a polished spiked helm.  Figuring it will make a good souvenir, you take it.")
HOMM2_MESSAGE("table.gArtifactEvent.78", "You come upon a bridge spanning a dry gully.  Before you can cross, a Troll steps out from under the bridge and demands payment before it will permit you to pass.  You refuse, and the Troll charges, forcing you to slay it.  You take its spiked shield as a trophy.")
HOMM2_MESSAGE("table.gArtifactEvent.79", "A walk across a dry saltwater lake bed yields an unlikely prize:  A white pearl amidst shattered shells and debris.")
HOMM2_MESSAGE("table.gArtifactEvent.8", "After rescuing a Sorceress from a cursed tomb, she rewards your heroism with an exquisite jeweled necklace.")
HOMM2_MESSAGE("table.gArtifactEvent.80", "Rumors of a Griffin of unusual size preying upon the countryside lead you to its cave lair.  A quick, brutal fight dispatches the beast, and a search of its foul nest turns up a huge black pearl.")
HOMM2_MESSAGE("table.gArtifactEvent.86", "You find an elaborate container which houses an old vellum scroll. The runes on the container are very old, and the artistry with which it was put together is stunning. As you pull the scroll out, you feel imbued with magical power.")
HOMM2_MESSAGE("table.gArtifactEvent.87", "One of the less intelligent members of your party picks up an arm off of the ground.  Despite its missing a body, it is still moving.  Your troops find the dismembered arm repulsive, but you cannot bring yourself to drop it: it seems to hold some sort of magical power that influences your decision making.")
HOMM2_MESSAGE("table.gArtifactEvent.88", "You come upon a sign.  It reads: \"Here lies the body of Anduran.  Bow and swear fealty, and you shall be rewarded.\"  You decide to do as it says.  As you stand up, you feel a coldness against your skin.  Looking down, you find that you are suddenly wearing a gleaming, ornate breastplate.")
HOMM2_MESSAGE("table.gArtifactEvent.89", "A kindly Sorceress thinks that your army's defenses could use a magical boost.  She offers to enchant the Broach that you wear on your cloak, and you accept.")
HOMM2_MESSAGE("table.gArtifactEvent.9", "While searching through the rubble of a caved-in mine, you free a group of trapped Dwarves.  Grateful, the leader gives you a golden bracelet.")
HOMM2_MESSAGE("table.gArtifactEvent.90", "Out of pity for a poor peasant, you purchase a chest of old junk they are hawking for too much gold. Later, as you search through it, you find it contains the 3 pieces of the legendary battle garb of Anduran!")
HOMM2_MESSAGE("table.gArtifactEvent.91", "You come upon a caravan of gypsies who are feasting and fortifying their bodies with mead.  They call you forward and say \"If you prove that you can dance the Rama-Buta, we will reward you.\"  You don't know it, but try anyway.  They laugh hysterically, but admire your bravery, giving you a Crystal Ball.")
HOMM2_MESSAGE("table.gArtifactEvent.92", "You enter a recently burned glade and come upon a Fire Elemental sitting atop a rock.  It looks up, its flaming face contorted in a look of severe pain.  It then tosses a glowing object at you.  You put up your hands to block it, but it passes right through them and sears itself into your chest.")
HOMM2_MESSAGE("table.gArtifactEvent.93", "Suddenly, a biting coldness engulfs your body.  You seize up, falling from your horse.  The pain subsides, but you still feel as if your chest is frozen.  As you pick yourself up off of the ground, you hear hearty laughter.  You turn around just in time to see a Frost Giant run off into the woods and disappear.")
HOMM2_MESSAGE("table.gArtifactEvent.94", "You spy a gleaming object poking up out of the ground.   You send a member of your party over to investigate.  He comes back with a golden helmet in his hands.  You realize that it must be the helmet of the legendary Anduran, the only man who was known to wear solid gold armor.")
HOMM2_MESSAGE("table.gArtifactEvent.95", "You come upon a battle where a Paladin has been mortally wounded by a group of Zombies.  He asks you to take his hammer and finish what he started.  As you pick it up, it begins to hum, and then everything becomes a blur.  The Zombies lie dead, the hammer dripping with blood.  You strap it to your belt.")
HOMM2_MESSAGE("table.gArtifactEvent.96", "Upon cresting a small hill, you come upon a ridiculous looking sight.  A Sprite is attempting to carry a Scepter that is almost as big as it is.  Trying not to laugh, you ask, \"Need help?\"  The Sprite glares at you and answers: \"You think this is funny?  Fine.  You can carry it.  I much prefer flying anyway.\"")
HOMM2_MESSAGE("table.gArtifactEvent.97", "An old seaman tells you a tale of an enchanted masthead that he used in his youth to rally his crew during times of trouble.  He then hands you a faded map that shows where he hid it.  After much exploring, you find it stashed underneath a nearby dock.")
HOMM2_MESSAGE("table.gArtifactEvent.98", "You stop to help a Peasant catch a runaway mare.  To show his gratitude, he hands you a tiny sphere.  As soon as you grasp it, you feel the magical energy drain from your limbs...")
HOMM2_MESSAGE("table.gArtifactEvent.99", "While out scaring up game, your troops find a mysterious staff levitating about three feet off of the ground.  They hand it to you, and you notice an inscription.  It reads: \"Brains best brawn and magic beats might.  Heed my words, and you'll win every fight.\"")
HOMM2_MESSAGE("table.gArtifactNames.0", "Ultimate Book of Knowledge")
HOMM2_MESSAGE("table.gArtifactNames.1", "Ultimate Sword of Dominion")
