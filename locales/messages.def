HOMM2_MESSAGE("table.gBuildingInfoSpecial.0", "The Fortifications increase the toughness of the walls, increasing the number of turns it takes to knock them down.")
HOMM2_MESSAGE("table.gBuildingInfoSpecial.1", "The Coliseum provides inspiring spectacles to defending troops, raising their morale by two during combat.")
HOMM2_MESSAGE("table.gBuildingInfoSpecial.2", "The Rainbow increases the luck of the defending units by two.")
HOMM2_MESSAGE("table.gBuildingInfoSpecial.3", "The Dungeon increases the income of the town by 500 / day.")
HOMM2_MESSAGE("table.gBuildingInfoSpecial.4", "The Library increases the number of spells in the Guild by one for each level of the guild.")
HOMM2_MESSAGE("table.gBuildingInfoSpecial.5", "The Storm adds +2 to the power of spells of a defending spell caster.")
HOMM2_MESSAGE("table.gCPanelHelp.0", "Start a single or multi-player game.")
HOMM2_MESSAGE("table.gCPanelHelp.1", "Load a previously saved game.")
HOMM2_MESSAGE("table.gCPanelHelp.2", "Save the current game.")
HOMM2_MESSAGE("table.gCPanelHelp.3", "Quit out of Heroes of Might and Magic II.")
HOMM2_MESSAGE("table.gCPanelHelp.4", "Exit this menu without doing anything.")
HOMM2_MESSAGE("table.gCSPanelHelp.0", "{OK}\n\nExit this menu.")
HOMM2_MESSAGE("table.gCSPanelHelp.1", "{Speed}\n\nSet the speed of combat actions and animations.")
HOMM2_MESSAGE("table.gCSPanelHelp.2", "{Monster Info}\n\nToggle the monster info window, which shows information on the active and targeted monsters.")
HOMM2_MESSAGE("table.gCSPanelHelp.3", "{Auto Combat\nSpell Casting}\n\nToggle whether or not the computer will cast spells for you when auto combat is on.  (Note: This does not affect spell casting for computer players in any way, nor does it affect quick combat.)")
HOMM2_MESSAGE("table.gCSPanelHelp.4", "{Grid}\n\nToggle the hex grid on or off.  The hex grid always underlies movement, even if turned off.  This switch only determines if the grid is visible.")
HOMM2_MESSAGE("table.gCSPanelHelp.5", "{Shadow Movement}\n\nToggle on or off a shadowing system showing where your creatures can move and attack.  When this is turned on, there is a slight performance cost, most noticeable on 486 computers.")
HOMM2_MESSAGE("table.gCSPanelHelp.6", "{Shadow Cursor}\n\nToggle on or off a shadowing system showing where the hex grid that the mouse cursor is currently over is shadowed.  When this is turned on, there is a slight performance cost, most noticeable on 486 computers.")
