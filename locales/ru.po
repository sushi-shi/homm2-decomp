msgctxt "table.gStatDesc.0"
msgid "{Attack Skill}\n\nYour attack skill is a bonus added to each creature's attack skill."
msgstr "{Атака}\n\nВаш навык атаки - бонус, добавляемый к навыку атаки каждого воина."

msgctxt "table.gStatDesc.1"
msgid "{Defense Skill}\n\nYour defense skill is a bonus added to each creature's defense skill."
msgstr "{Защита}\n\nВаш навык защиты - бонус, добавляемый к навыку защиты каждого воина."

msgctxt "table.gStatDesc.2"
msgid "{Spell Power}\n\nYour spell power determines the length or power of a spell."
msgstr "{Сила магии}\n\nВаш уровень силы магии определяет длительность действия или силу заклинания."

msgctxt "table.gStatDesc.3"
msgid "{Knowledge}\n\nYour knowledge determines how many spell points your hero may have.  Under normal cirumstances, a hero is limited to 10 spell points per level of knowledge."
msgstr "{Знания}\n\nУровень знаний определяет количество очков магии героя."

