msgctxt "table.cSecSkillDesc.0.0"
msgid "{Basic Pathfinding}\n\nBasic Pathfinding reduces the movement penalty for rough terrain by 25 percent."
msgstr "{Следопыт 1 ступени}\n\nУменьшает замедление при передвижении по пересеченной местности на 25 процентов."

msgctxt "table.cSecSkillDesc.0.1"
msgid "{Advanced Pathfinding}\n\nAdvanced Pathfinding reduces the movement penalty for rough terrain by 50 percent."
msgstr "{Следопыт 2 ступени}\n\nУменьшает замедление при передвижении по пересеченной местности на 50 процентов."

msgctxt "table.cSecSkillDesc.0.2"
msgid "{Expert Pathfinding}\n\nExpert Pathfinding eliminates the movement penalty for rough terrain."
msgstr "{Следопыт 3 ступени}\n\nПолностью нейтрализует замедление при передвижении по пересеченной местности."

msgctxt "table.cSecSkillDesc.1.0"
msgid "{Basic Archery}\n\nBasic Archery increases the damage done by range attacking creatures by 10 percent."
msgstr "{Стрелок 1 ступени}\n\nУвеличивает на 10 процентов урон, наносимый стреляющими отрядами."

msgctxt "table.cSecSkillDesc.1.1"
msgid "{Advanced Archery}\n\nAdvanced Archery increases the damage done by range attacking creatures by 25 percent."
msgstr "{Стрелок 2 ступени}\n\nУвеличивает на 25 процентов урон, наносимый стреляющими отрядами."

msgctxt "table.cSecSkillDesc.1.2"
msgid "{Expert Archery}\n\nExpert Archery increases the damage done by range attacking creatures by 50 percent."
msgstr "{Стрелок 3 ступени}\n\nУвеличивает на 50 процентов урон, наносимый стреляющими отрядами."

msgctxt "table.cSecSkillDesc.10.0"
msgid "{Basic Ballistics}\n\nBasic Ballistics gives your hero's catapult shots a greater chance to hit and do damage to castle walls."
msgstr "{Баллистика 1 ступени}\n\nУвеличивает точность стрельбы  катапульты вашего героя и урон, наносимый крепостным стенам."

msgctxt "table.cSecSkillDesc.10.1"
msgid "{Advanced Ballistics}\n\nAdvanced Ballistics gives your hero's catapult an extra shot, and each shot has a greater chance to hit and do damage to castle walls."
msgstr "{Баллистика 2 ступени}\n\nКатапульта вашего героя делает дополнительный выстрел; при этом увеличивается точность ее стрельбы и урон, наносимый крепостным стенам."

msgctxt "table.cSecSkillDesc.10.2"
msgid "{Expert Ballistics}\n\nExpert Ballistics gives your hero's catapult an extra shot, and each shot automatically destroys any wall, except a fortified wall in a Knight town."
msgstr "{Баллистика 3 ступени}\n\nКатапульта вашего героя делает дополнительный выстрел; при этом каждый выстрел разрушает любую стену, за исключением укрепленных стен рыцарского замка."

msgctxt "table.cSecSkillDesc.11.0"
msgid "{Basic Eagle Eye}\n\nBasic Eagle Eye gives your hero a 20 percent chance to learn any given 1st or 2nd level enemy spell used against him in a combat."
msgstr "{Орлиный взор 1 ступени}\n\nДает вашему герою 20-процентный шанс выучить любое заклинание первого или второго уровней, примененное против него в бою."

msgctxt "table.cSecSkillDesc.11.1"
msgid "{Advanced Eagle Eye}\n\nAdvanced Eagle Eye gives your hero a 30 percent chance to learn any given 3rd level spell (or below) used against him in combat."
msgstr "{Орлиный взор 2 ступени}\n\nДает вашему герою 30-процентный шанс выучить любое заклинание третьего или более низких уровней, примененное против него в бою."

msgctxt "table.cSecSkillDesc.11.2"
msgid "{Expert Eagle Eye}\n\nExpert Eagle Eye gives your hero a 40 percent chance to learn any given 4th level spell (or below) used against him in combat."
msgstr "{Орлиный глаз 3 ступени}\n\nДает вашему герою 40-процентный шанс выучить любое заклинание четвертого или более низких уровней, примененное против него в бою."

msgctxt "table.cSecSkillDesc.12.0"
msgid "{Basic Necromancy}\n\nBasic Necromancy allows 10 percent of the creatures killed in combat to be brought back from the dead as Skeletons."
msgstr "{Некромантия 1 ступени}\n\nВоскрешает 10 процентов существ, павших на поле боя, и превращает их в скелеты для вашей армии."

msgctxt "table.cSecSkillDesc.12.1"
msgid "{Advanced Necromancy}\n\nAdvanced Necromancy allows 20 percent of the creatures killed in combat to be brought back from the dead as Skeletons."
msgstr "{Некромантия 2 ступени}\n\nВоскрешает 20 процентов существ, павших на поле боя, и превращает их в скелеты для вашей армии."

msgctxt "table.cSecSkillDesc.12.2"
msgid "{Expert Necromancy}\n\nExpert Necromancy allows 30 percent of the creatures killed in combat to be brought back from the dead as Skeletons."
msgstr "{Некромантия 3 ступени}\n\nВоскрешает 30 процентов существ, павших на поле боя, и превращает их в скелеты для вашей армии."

msgctxt "table.cSecSkillDesc.13.0"
msgid "{Small Estates}\n\nYour hero produces 100 gold pieces per turn as tax revenue from estates."
msgstr "{Казначей 1 ступени}\n\nВаш герой ежедневно собирает со своих владений налоги в размере 100 золотых."

msgctxt "table.cSecSkillDesc.13.1"
msgid "{Moderate Estates}\n\nYour hero produces 250 gold pieces per turn as tax revenue from estates."
msgstr "{Казанчей 2 ступени}\n\nВаш герой ежедневно собирает со своих владений налоги в размере 250 золотых."

msgctxt "table.cSecSkillDesc.13.2"
msgid "{Grand Estates}\n\nYour hero produces 500 gold pieces per turn as tax revenue from estates."
msgstr "{Казначей 3 ступени}\n\n Ваш герой ежедневно собирает со своих владений налоги в размере 500 золотых."

msgctxt "table.cSecSkillDesc.2.0"
msgid "{Basic Logistics}\n\nBasic Logistics increases your hero's movement points by 10 percent."
msgstr "{Логистика 1 ступени}\n\nУвеличивает запас движения героя на 10 процентов."

msgctxt "table.cSecSkillDesc.2.1"
msgid "{Advanced Logistics}\n\nAdvanced Logistics increases your hero's movement points by 20 percent."
msgstr "{Логистика 2 ступени}\n\nУвеличивает запас движения героя на 20 процентов."

msgctxt "table.cSecSkillDesc.2.2"
msgid "{Expert Logistics}\n\nExpert Logistics increases your hero's movement points by 30 percent."
msgstr "{Логистика 3 ступени}\n\nУвеличивает запас движения героя на 30 процентов."

msgctxt "table.cSecSkillDesc.3.0"
msgid "{Basic Scouting}\n\nBasic Scouting increases your hero's viewable area by 1 square."
msgstr "{Разведка 1 ступени}\n\nУвеличивает на 1 клетку радиус обзора героя."

msgctxt "table.cSecSkillDesc.3.1"
msgid "{Advanced Scouting}\n\nAdvanced Scouting increases your hero's viewable area by 2 squares."
msgstr "{Разведка 2 ступени}\n\nУвеличивает на 2 клетки радиус обзора героя."

msgctxt "table.cSecSkillDesc.3.2"
msgid "{Expert Scouting}\n\nExpert Scouting increases your hero's viewable area by 3 squares."
msgstr "{Разведка 3 ступени}\n\nУвеличивает на 3 клетки радиус обзора героя."

msgctxt "table.cSecSkillDesc.4.0"
msgid "{Basic Diplomacy}\n\nBasic Diplomacy allows you to negotiate with monsters who are weaker than your group.  Approximately 1/4 of the creatures may offer to join you."
msgstr "{Дипломатия 1 ступени}\n\nПозволяет вести переговоры с отрядами монстров, более слабыми, чем ваша армия. На таком уровне дипломатии к вам может присоединиться до 1/4 отряда монстров."

msgctxt "table.cSecSkillDesc.4.1"
msgid "{Advanced Diplomacy}\n\nAdvanced Diplomacy allows you to negotiate with monsters who are weaker than your group.  Approximately 1/2 of the creatures may offer to join you."
msgstr "{Дипломатия 2 ступени}\n\nПозволяет вести переговоры с отрядами монстров, более слабыми, чем ваша армия. На таком уровне дипломатии к вам может присоединиться до 1/2 отряда монстров."

msgctxt "table.cSecSkillDesc.4.2"
msgid "{Expert Diplomacy}\n\nExpert Diplomacy allows you to negotiate with monsters who are weaker than your group.  All of the creatures may offer to join you."
msgstr "{Дипломатия 3 ступени}\n\nПозволяет вести переговоры с отрядами монстров, более слабыми, чем ваша армия. На таком уровне дипломатии к вам может присоединиться весь отряд монстров."

msgctxt "table.cSecSkillDesc.5.0"
msgid "{Basic Navigation}\n\nBasic Navigation increases your hero's movement points over water by 1/3."
msgstr "{Навигация 1 ступени}\n\nУвеличивает на 1/3 запас движения героя при передвижении по воде."

msgctxt "table.cSecSkillDesc.5.1"
msgid "{Advanced Navigation}\n\nAdvanced Navigation increases your hero's movement points over water by 2/3."
msgstr "{Навигация 2 ступени}\n\nУвеличивает на 2/3 запас движения героя при передвижении по воде."

msgctxt "table.cSecSkillDesc.5.2"
msgid "{Expert Navigation}\n\nExpert Navigation doubles your hero's movement points over water."
msgstr "{Навигация 3 ступени}\n\nУдваивает запас движения героя при передвижении по воде."

msgctxt "table.cSecSkillDesc.6.0"
msgid "{Basic Leadership}\n\nBasic Leadership increases your hero's troops' morale by 1."
msgstr "{Лидерство 1 ступени}\n\nУвеличивает на 1 единицу мораль войск вашего героя."

msgctxt "table.cSecSkillDesc.6.1"
msgid "{Advanced Leadership}\n\nAdvanced Leadership increases your hero's troops' morale by 2."
msgstr "{Лидерство 2 ступени}\n\nУвеличивает на 2 единицы мораль войск вашего героя."

msgctxt "table.cSecSkillDesc.6.2"
msgid "{Expert Leadership}\n\nExpert Leadership increases your hero's troops' morale by 3."
msgstr "{Лидерство 3 ступени}\n\nУвеличивает на 3 единицы мораль войск вашего героя."

msgctxt "table.cSecSkillDesc.7.0"
msgid "{Basic Wisdom}\n\nBasic Wisdom allows your hero to learn third level spells."
msgstr "{Мудрость 1 ступени}\n\nПозволяет вашему герою изучать заклинания третьего уровня."

msgctxt "table.cSecSkillDesc.7.1"
msgid "{Advanced Wisdom}\n\nAdvanced Wisdom allows your hero to learn fourth level spells."
msgstr "{Мудрость 2 ступени}\n\nПозволяет вашему герою изучать заклинания четвертого уровня."

msgctxt "table.cSecSkillDesc.7.2"
msgid "{Expert Wisdom}\n\nExpert Wisdom allows your hero to learn fifth level spells."
msgstr "{Мудрость 3 ступени}\n\nПозволяет вашему герою изучать заклинания пятого уровня."

msgctxt "table.cSecSkillDesc.8.0"
msgid "{Basic Mysticism}\n\nBasic Mysticism regenerates two of your hero's spell points per day."
msgstr "{Мистицизм 1 ступени}\n\nВаш герой восстанавливает по 2 очка магии в день."

msgctxt "table.cSecSkillDesc.8.1"
msgid "{Advanced Mysticism}\n\nAdvanced Mysticism regenerates three of your hero's spell points per day."
msgstr "{Мистицизм 2 ступени}\n\nВаш герой восстанавливает по 3 очка магии в день."

msgctxt "table.cSecSkillDesc.8.2"
msgid "{Expert Mysticism}\n\nExpert Mysticism regenerates four of your hero's spell points per day."
msgstr "{Мистицизм 3 ступени}\n\nВаш герой восстанавливает по 4 очка магии в день."

msgctxt "table.cSecSkillDesc.9.0"
msgid "{Basic Luck}\n\nBasic Luck increases your hero's luck by 1."
msgstr "{Удача 1 ступени}\n\nУвеличивает на 1 удачу вашего героя."

msgctxt "table.cSecSkillDesc.9.1"
msgid "{Advanced Luck}\n\nAdvanced Luck increases your hero's luck by 2."
msgstr "{Удача 2 ступени}\n\nУвеличивает на 2 удачу вашего героя."

msgctxt "table.cSecSkillDesc.9.2"
msgid "{Expert Luck}\n\nExpert Luck increases your hero's luck by 3."
msgstr "{Удача 3 ступени}\n\nУвеличивает на 3 удачу вашего героя."

