msgid ""
"\n"
"(Cheater)"
msgstr ""
"\n"
"(Читер)"

#: src/SOURCE/Modem.cpp
msgctxt "network.modem.direct_wait"
msgid ""
"Waiting for other computer to log in to direct connection.\n"
"\n"
"Press 'CANCEL' to abort."
msgstr ""
"Ожидание подключения другого компьютера к прямому соединению.\n"
"\n"
"Нажмите 'ОТМЕНА', чтобы прервать ожидание."

