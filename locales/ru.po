#, c-format
msgctxt "table.cWinComError.0"
msgid ""
"Communications error on function '%s'\n"
"\n"
"Win95 Error Code: %d\n"
"Win95 Error Meaning: %s\n"
"\n"
msgstr ""
"Ошибка передачи данных при выполнении функции %s\n"
"\n"
"Код ошибки: %d\n"
"Значение ошибки: %s\n"
"\n"

#. Legacy table entry; English is authoritative in the C++ initializer.
#: src/SOURCE/KB.cpp
msgctxt "table.cWinComError.1"
msgid "Suggested solutions:"
msgstr "Предлагаемые меры устранения ошибки:"

#. Legacy table entry; English is authoritative in the C++ initializer.
#: src/SOURCE/KB.cpp
msgctxt "table.cWinComError.2"
msgid ""
"\n"
"  1) Make sure all cables are firmly connected."
msgstr ""
"\n"
"1) Убедитесь в надежности подсоединения кабелей."

#. Legacy table entry; English is authoritative in the C++ initializer.
#: src/SOURCE/KB.cpp
msgctxt "table.cWinComError.3"
msgid ""
"\n"
"  2) Reboot computer."
msgstr ""
"\n"
"2) Перезагрузите компьютер."

#. Legacy table entry; English is authoritative in the C++ initializer.
#: src/SOURCE/KB.cpp
msgctxt "table.cWinComError.4"
msgid ""
"\n"
"  3) Check to make sure you have the correct COM port setting in 'CONFIG'. (The 3rd button down on the screen where you choose Host or Guest.)"
msgstr ""
"\n"
"3) Убедитесь в том, что в 'CONFIG' задан правильный COM порт. (Третья кнопка на экране, где вы выбираете Хозяина или Гостя.)"

#. Legacy table entry; English is authoritative in the C++ initializer.
#: src/SOURCE/KB.cpp
msgctxt "table.cWinComError.5"
msgid ""
"\n"
"  4) Consider lowering the BAUD rate in 'CONFIG' to 19200 or 9600."
msgstr ""
"\n"
"4) Попробуйте уменьшить скорость передачи данных в 'CONFIG' до 19200 или до 9600."

