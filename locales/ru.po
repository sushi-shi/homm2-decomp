msgctxt "table.gSPanelHelp.0"
msgid "{OK}\n\nExit this menu."
msgstr "{ОК}\n\nЗакрыть меню."

msgctxt "table.gSPanelHelp.1"
msgid "{Music}\n\nToggle ambient music level."
msgstr "{Музыка}\n\nВключить или выключить фоновую музыку."

msgctxt "table.gSPanelHelp.2"
msgid "{Effects}\n\nToggle foreground sounds level."
msgstr "{Эффекты}\n\nВключить или выключить звуковые эффекты."

msgctxt "table.gSPanelHelp.3"
msgid "{Speed}\n\nChange the speed at which your heroes move on the main screen."
msgstr "{Скорость}\n\nВыбрать скорость передвижения героев по карте."

msgctxt "table.gSPanelHelp.4"
msgid "{Music Type}\n\nHeroes II uses MIDI music."
msgstr "{Качество звука}\n\nВыбрать формат музыки. Как правило, музыка в формате MIDI не отличается качеством, но она предъявляет меньшие требования к производительности системы, чем формат Стерео CD. Формат Стерео CD дает  возможность воспроизводить оперную музыку."

msgctxt "table.gSPanelHelp.5"
msgid "{Show Path}\n\nToggle 'Show Path' on/off.  If 'Show Path' is on, your first click on a map location will show the path to get there, your second will start you moving. If this option is off, one click starts you moving immediately."
msgstr "{Показывать путь}\n\nВключить или выключить отображение пути героя на карте.  Если опция включена, первое нажатие по объекту на карте показывает путь к этому объекту, а по второму нажатию левой кнпоки мыши начинается движение. Если эта опция отключена, движение начинается по первому нажатию."

msgctxt "table.gSPanelHelp.6"
msgid "{Enemy Speed}\n\nSets the speed that A.I. heroes move at.  You can also elect not to view A.I. movement at all."
msgstr "{Скорость врага}\n\nВыбрать скорости перемещения героев, управляемых компьютером. При этом можно выбрать режим, в котором не будет отображаться передвижение противника."

msgctxt "table.gSPanelHelp.7"
msgid "{Interface}\n\nSets what type of interface you want to use.  The default selection is a dynamic interface, which uses Evil graphics for the 3 evil heroes (Barbarian, Warlock, and Necromancer)."
msgstr "{Интерфейс}\n\nВыбор желаемого типа интерфейса. По умолчанию задан динамический интерфейс, в котором 'злое' графическое оформление используется для трех 'злых' классов героев (варвара, чернокнижника и некроманта)."

msgctxt "table.gSPanelHelp.8"
msgid "{Video}\n\nDetermines if the video sequences play normally or in interlaced mode. Interlaced mode runs better on slower machines."
msgstr "{Быстрый бой}\n\nПри включении этой опции перед каждым сражением компьютер будет делать запрос о проведении этого сражения в режиме быстрого боя. Сражение протекает автоматически, и компьютер демонстрирует вам только его результат."

msgctxt "table.gSPanelHelp.9"
msgid "{Mouse Cursor}\n\nToggle color cursors on/off.  Color cursors look nicer, but sometimes don't move as smoothly as black and white ones."
msgstr "{Курсор}\n\nПереключение курсора с черно-белого на цветной и обратно. Цветной курсор выглядит симпатичнее, но иногда он перемещается по экрану не так плавно, как черно-белый."

