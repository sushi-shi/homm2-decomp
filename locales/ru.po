msgctxt "table.gSetupBaudHelp.0"
msgid "{2400 Baud}\n\nUse a 2400 baud connection speed. \n\nNote: For a 14400 baud modem, use the 19200 baud speed.  For a 28800 baud modem, use the 38400 baud speed."
msgstr "{2400 бод}\n\nИспользовать соединение на скорости 2400 бод.\n\nЗамечание: Для модемов 14400 бод используйте соединение на скорости 19200.  Для модемов 28800 бод используйте соединение на скорости 38400 бод."

msgctxt "table.gSetupBaudHelp.1"
msgid "{9600 Baud}\n\nUse a 9600 baud connection speed. \n\nNote: For a 14400 baud modem, use the 19200 baud speed.  For a 28800 baud modem, use the 38400 baud speed."
msgstr "{9600 бод}\n\nИспользовать соединение на скорости 9600 бод.\n\nЗамечание: Для модемов 14400 бод используйте соединение на скорости 19200.  Для модемов 28800 бод используйте соединение на скорости 38400 бод."

msgctxt "table.gSetupBaudHelp.2"
msgid "{19200 Baud}\n\nUse a 19200 baud connection speed.\n\nNote: For a 14400 baud modem, use the 19200 baud speed.  For a 28800 baud modem, use the 38400 baud speed."
msgstr "{19200 бод}\n\nИспользовать соединение на скорости 19200 бод.\n\nЗамечание: Для модемов 14400 бод используйте соединение на скорости 19200.  Для модемов 28800 бод используйте соединение на скорости 38400 бод."

msgctxt "table.gSetupBaudHelp.3"
msgid "{38400 Baud}\n\nUse a 38400 baud connection speed.\n\nNote: For a 14400 baud modem, use the 19200 baud speed.  For a 28800 baud modem, use the 38400 baud speed."
msgstr "{38400 бод}\n\nИспользовать соединение на скорости 38400 бод.\n\nЗамечание: Для модемов 14400 бод используйте соединение на скорости 19200.  Для модемов 28800 бод используйте соединение на скорости 38400 бод."

msgctxt "table.gSetupBaudHelp.4"
msgid "{Cancel}\n\nCancel back to the main menu."
msgstr "{Отменить}\n\nОтменить и вернуться в главное меню."

msgctxt "table.gSetupComPortHelp.0"
msgid "{COM 1}\n\nUse COM Port 1 for the modem connection."
msgstr "{COM 1}\n\nИспользовать для модемного соединения порт COM 1."

msgctxt "table.gSetupComPortHelp.1"
msgid "{COM 2}\n\nUse COM Port 2 for the modem connection."
msgstr "{COM 2}\n\nИспользовать для модемного соединения порт COM 2."

msgctxt "table.gSetupComPortHelp.2"
msgid "{COM 3}\n\nUse COM Port 3 for the modem connection."
msgstr "{COM 3}\n\nИспользовать для модемного соединения порт COM 3."

msgctxt "table.gSetupComPortHelp.3"
msgid "{COM 4}\n\nUse COM Port 4 for the modem connection."
msgstr "{COM 4}\n\nИспользовать для модемного соединения порт COM 4."

msgctxt "table.gSetupComPortHelp.4"
msgid "{Cancel}\n\nCancel back to the main menu."
msgstr "{Отменить}\n\nОтменить и вернуться в главное меню."

msgctxt "table.gSetupDCBaudHelp.0"
msgid "{2400 Baud}\n\nUse a 2400 baud connection speed. \n\nNote: In general, computers with the older UART 8250 chip should use 19200 baud, and computers with the newer UART 16550 chip should use 38400 baud.  When in doubt, try slower speeds first, and if they work, then try faster speeds.  Most computers made in 1994 or later have a UART 16550 chip."
msgstr "{Скорость соединения 2400 бод.}\n\nДля компьютеров с устаревшим чипом UART 8250 следует использовать скорость 19200 бод, а для компьютеров с более современным чипом UART 16550 - скорость 38400 бод. Если вы не уверены, какой у вас чип, начните с более низких скоростей. В большинстве компьютеров, произведенных в 1994 году и позднее, используется чип UART 16550."

msgctxt "table.gSetupDCBaudHelp.1"
msgid "{9600 Baud}\n\nUse a 9600 baud connection speed. \n\nNote: In general, computers with the older UART 8250 chip should use 19200 baud, and computers with the newer UART 16550 chip should use 38400 baud.  When in doubt, try slower speeds first, and if they work, then try faster speeds.  Most computers made in 1994 or later have a UART 16550 chip."
msgstr "{Скорость соединения 9600 бод.}\n\n Для компьютеров с устаревшим чипом UART 8250 следует использовать скорость 19200 бод, а для компьютеров с более современным чипом UART 16550 - скорость 38400 бод. Если вы не уверены, какой у вас чип, начните с более низких скоростей. В большинстве компьютеров, произведенных в 1994 году и позднее, используется чип UART 16550."

msgctxt "table.gSetupDCBaudHelp.2"
msgid "{19200 Baud}\n\nUse a 19200 baud connection speed.\n\nNote: In general, computers with the older UART 8250 chip should use 19200 baud, and computers with the newer UART 16550 chip should use 38400 baud.  When in doubt, try slower speeds first, and if they work, then try faster speeds.  Most computers made in 1994 or later have a UART 16550 chip."
msgstr "{Скорость соединения 19200 бод.}\n\n Для компьютеров с устаревшим чипом UART 8250 следует использовать скорость 19200 бод, а для компьютеров с более современным чипом UART 16550 - скорость 38400 бод. Если вы не уверены, какой у вас чип, начните с более низких скоростей. В большинстве компьютеров, произведенных в 1994 году и позднее, используется чип UART 16550."

msgctxt "table.gSetupDCBaudHelp.3"
msgid "{38400 Baud}\n\nUse a 38400 baud connection speed.\n\nNote: In general, computers with the older UART 8250 chip should use 19200 baud, and computers with the newer UART 16550 chip should use 38400 baud.  When in doubt, try slower speeds first, and if they work, then try faster speeds.  Most computers made in 1994 or later have a UART 16550 chip."
msgstr "{Скорость соединения 38400 бод.}\n\n Для компьютеров с устаревшим чипом UART 8250 следует использовать скорость 19200 бод, а для компьютеров с более современным чипом UART 16550 - скорость 38400 бод. Если вы не уверены, какой у вас чип, начните с более низких скоростей. В большинстве компьютеров, произведенных в 1994 году и позднее, используется чип UART 16550."

msgctxt "table.gSetupDCBaudHelp.4"
msgid "{Cancel}\n\nCancel back to the main menu."
msgstr "{Отменить}\n\nОтменить и вернуться в главное меню."

