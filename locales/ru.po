#: src/SOURCE/netwin.cpp
#, c-format
msgctxt "network.tcp.host.expected_guests"
msgid ""
"Hosting game at %s.\n"
"\n"
"You have %d guest out of an expected total of %d guests now logged in.  Click 'CANCEL' to move on without waiting for additional guests."
msgid_plural ""
"Hosting game at %s.\n"
"\n"
"You have %d guests out of an expected total of %d guests now logged in.  Click 'CANCEL' to move on without waiting for additional guests."
msgstr[0] ""
"Игра размещена по адресу %s.\n"
"\n"
"Подключен %d гость из %d ожидаемых. Нажмите 'ОТМЕНА', чтобы продолжить, не дожидаясь других гостей."
msgstr[1] ""
"Игра размещена по адресу %s.\n"
"\n"
"Подключено %d гостя из %d ожидаемых. Нажмите 'ОТМЕНА', чтобы продолжить, не дожидаясь других гостей."
msgstr[2] ""
"Игра размещена по адресу %s.\n"
"\n"
"Подключено %d гостей из %d ожидаемых. Нажмите 'ОТМЕНА', чтобы продолжить, не дожидаясь других гостей."

#: src/SOURCE/netwin.cpp
#, c-format
msgctxt "network.tcp.host.waiting_guests"
msgid ""
"Hosting game at %s\n"
"\n"
"Waiting on guests.\n"
"\n"
"Press 'CANCEL' to abort."
msgstr ""
"Игра размещена по адресу %s.\n"
"\n"
"Ожидание гостей.\n"
"\n"
"Нажмите 'ОТМЕНА' для отмены."

#: src/SOURCE/netwin.cpp
#, c-format
msgctxt "network.tcp.host.connected_guests"
msgid ""
"Hosting game at %s.\n"
"\n"
"You have %d guest now logged in.  Click 'OK' to move on, or wait for additional guests."
msgid_plural ""
"Hosting game at %s.\n"
"\n"
"You have %d guests now logged in.  Click 'OK' to move on, or wait for additional guests."
msgstr[0] ""
"Игра размещена по адресу %s.\n"
"\n"
"Подключен %d гость. Нажмите 'ОК', чтобы продолжить, или дождитесь других гостей."
msgstr[1] ""
"Игра размещена по адресу %s.\n"
"\n"
"Подключено %d гостя. Нажмите 'ОК', чтобы продолжить, или дождитесь других гостей."
msgstr[2] ""
"Игра размещена по адресу %s.\n"
"\n"
"Подключено %d гостей. Нажмите 'ОК', чтобы продолжить, или дождитесь других гостей."

