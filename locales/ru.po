#: src/SOURCE/SETUP.cpp
msgctxt "network.modem.initialization_prompt"
msgid "Please enter any special initialization string required by your modem, or hit 'ENTER' to accept the default."
msgstr "Пожалуйста, укажите строку инициализации модема или нажмите 'ENTER', чтобы принять значение по умолчанию."

