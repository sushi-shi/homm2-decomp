msgctxt "table.gSpellDesc.0"
msgid "{Fireball}\n\nCauses a giant fireball to strike the selected area, damaging all nearby creatures."
msgstr "{Огненный шар}\n\nОгромный огненный шар взрывается над выбранным участком поля боя, поражая все находящиеся поблизости отряды."

msgctxt "table.gSpellDesc.1"
msgid "{Fireblast}\n\nAn improved version of fireball, fireblast affects two hexes around the center point of the spell, rather than one."
msgstr "{Огненный удар}\n\nУсовершенствованный вариант огненного шара. Огненный удар поражает отряды, находящиеся в радиусе не одного, а двух полей от эпицентра."

msgctxt "table.gSpellDesc.10"
msgid "{Mass Haste}\n\nIncreases the speed of all of your creatures by two."
msgstr "{Общее ускорение}\n\nУвеличивает дальность передвижения всех ваших отрядов на 2 единицы."

msgctxt "table.gSpellDesc.11"
msgid "{Slow}\n\nSlows target to half movement rate."
msgstr "{Замедление}\n\nВдвое уменьшает дальность передвижения выбранного отряда противника."

msgctxt "table.gSpellDesc.12"
msgid "{Mass Slow}\n\nSlows all enemies to half movement rate."
msgstr "{Общее замедление}\n\nВдвое снижает дальность перемещения всех отрядов противника."

msgctxt "table.gSpellDesc.13"
msgid "{Blind }\n\nClouds the affected creatures' eyes, preventing them from moving."
msgstr "{Ослепление}\n\nЗатуманивает взоры воинов выбранного отряда и тем самым не позволяет им перемещаться по полю боя."

msgctxt "table.gSpellDesc.14"
msgid "{Bless}\n\nCauses the selected creatures to inflict maximum damage."
msgstr "{Благословение}\n\nУвеличивает до максимума урон, наносимый выбранным отрядом."

msgctxt "table.gSpellDesc.15"
msgid "{Mass Bless}\n\nCauses all of your units to inflict maximum damage."
msgstr "{Общее благословение}\n\nУвеличивает до максимума урон, наносимый всеми вашими отрядами."

msgctxt "table.gSpellDesc.16"
msgid "{Stoneskin}\n\nMagically increases the defense skill of the selected creatures."
msgstr "{Каменная кожа}\n\nВолшебным образом повышает защищенность выбранного отряда."

msgctxt "table.gSpellDesc.17"
msgid "{Steelskin}\n\nIncreases the defense skill of the targeted creatures.  This is an improved version of Stoneskin."
msgstr "{Стальная кожа}\n\nПовышает защищенность выбранного отряда. Усовершенствованный вариант заклинания Каменная кожа."

msgctxt "table.gSpellDesc.18"
msgid "{Curse}\n\nCauses the selected creatures to inflict minimum damage."
msgstr "{Проклятие}\n\nУменьшает до минимума урон, причиняемый выбранным отрядом противника."

msgctxt "table.gSpellDesc.19"
msgid "{Mass Curse}\n\nCauses all enemy troops to inflict minimum damage."
msgstr "{Общее проклятие}\n\nУменьшает до минимума урон, причиняемый всеми отрядами противника."

msgctxt "table.gSpellDesc.2"
msgid "{Lightning Bolt}\n\nCauses a bolt of electrical energy to strike the selected creature."
msgstr "{Молния}\n\nМощный электрический разряд поражает выбранный отряд противника."

msgctxt "table.gSpellDesc.20"
msgid "{Holy Word}\n\nDamages all undead in the battle."
msgstr "{Святое слово}\n\nНаносит урон всей нежити на поле боя."

msgctxt "table.gSpellDesc.21"
msgid "{Holy Shout}\n\nDamages all undead in the battle.  This is an improved version of Holy Word."
msgstr "{Святой глас}\n\nНаносит урон всей нежити на поле боя. Усовершенствованный вариант заклинания Святое слово."

msgctxt "table.gSpellDesc.22"
msgid "{Anti-Magic}\n\nPrevents harmful magic against the selected creatures."
msgstr "{Антимагия}\n\nЗащищает выбранный отряд от враждебных заклинаний."

msgctxt "table.gSpellDesc.23"
msgid "{Dispel Magic}\n\nRemoves all magic spells from a single target."
msgstr "{Снятие чар}\n\nСнимает все чары с выбранного отряда."

msgctxt "table.gSpellDesc.24"
msgid "{Mass Dispel}\n\nRemoves all magic spells from all creatures."
msgstr "{Общее снятие чар}\n\nСнимает все чары со всех отрядов."

msgctxt "table.gSpellDesc.25"
msgid "{Magic Arrow}\n\nCauses a magic arrow to strike the selected target."
msgstr "{Волшебная стрела}\n\nВолшебная стрела поражает выбранный отряд противника."

msgctxt "table.gSpellDesc.26"
msgid "{Berzerker}\n\nCauses a creature to attack its nearest neighbor."
msgstr "{Берсерк}\n\nЗаставляет выбранный отряд противника нападать на ближайший к нему отряд."

msgctxt "table.gSpellDesc.27"
msgid "{Armageddon}\n\nHoly terror strikes the battlefield, causing severe damage to all creatures."
msgstr "{Армагеддон}\n\nУжасный катаклизм обрушивается на поле боя, нанося жестокий урон всем участникам сражения."

msgctxt "table.gSpellDesc.28"
msgid "{Elemental Storm}\n\nMagical elements pour down on the battlefield, damaging all creatures."
msgstr "{Буря стихий}\n\nСилы стихий обрушиваются на поле боя, нанося урон всем участникам сражения."

msgctxt "table.gSpellDesc.29"
msgid "{Meteor Shower}\n\nA rain of rocks strikes an area of the battlefield, damaging all nearby creatures."
msgstr "{Звездопад}\n\nЗвездопад поражает выбранный участок поля боя, нанося урон всем находящимся поблизости участникам сражения."

msgctxt "table.gSpellDesc.3"
msgid "{Chain Lightning}\n\nCauses a bolt of electrical energy to strike a selected creature, then strike the nearest creature with half damage, then strike the NEXT nearest creature with half again damage, and so on, until it becomes too weak to be harmful.  Warning:  This spell can hit your own creatures!"
msgstr "{Цепь молний}\n\nЭлектрический разряд поражает выбранный отряд противника, затем ближайший к нему отряд с половинной силой, затем следующий отряд c еще вдвое меньшей силой, и так далее до тех пор, пока не уходит в землю. Будьте осторожны: это заклинание может поразить и ваши собственные отряды!"

msgctxt "table.gSpellDesc.30"
msgid "{Paralyze}\n\nThe targeted creatures are paralyzed, unable to move or retaliate."
msgstr "{Паралич}\n\nОтряд, против которого направлено это заклинание, поражает паралич, и он теряет способность передвигаться или отвечать на удары."

msgctxt "table.gSpellDesc.31"
msgid "{Hypnotize}\n\nBrings a single enemy unit under your control for one combat round if its hits are less than 25 times the caster's spell power."
msgstr "{Гипноз}\n\nВыбранный отряд противника переходит под контроль вашего героя на один ход, если его суммарное здоровье не превышает магических способностей героя, умноженных на 25."

msgctxt "table.gSpellDesc.32"
msgid "{Cold Ray}\n\nDrains body heat from a single enemy unit."
msgstr "{Хладный луч}\n\nВысасывает тепло жизни из выбранного отряда противника."

msgctxt "table.gSpellDesc.33"
msgid "{Cold Ring}\n\nDrains body heat from all units surrounding the center point, but not including the center point."
msgstr "{Кольцо стужи}\n\nВысасывает тепло жизни из всех отрядов вокруг эпицентра заклинания, за исключением находящегося в самом эпицентре."

msgctxt "table.gSpellDesc.34"
msgid "{Disrupting Ray}\n\nReduces the defense rating of an enemy unit by three."
msgstr "{Разрушительный луч}\n\nПонижает защиту выбранного отряда противника на 3 единицы."

msgctxt "table.gSpellDesc.35"
msgid "{Death Ripple}\n\nDamages all living (non-undead) units in the battle."
msgstr "{Дрожь смерти}\n\nНаносит урон всем отрядам живых воинов в сражении, но не действует на нежить."

msgctxt "table.gSpellDesc.36"
msgid "{Death Wave}\n\nDamages all living (non-undead) units in the battle.  This spell is an improved version of Death Ripple."
msgstr "{Волна смерти}\n\nНаносит урон всем отрядам живых воинов в сражении, но не действует на нежить. Усовершенствованный вариант заклинания Дрожь смерти."

msgctxt "table.gSpellDesc.37"
msgid "{Dragon Slayer}\n\nGreatly increases a unit's attack skill vs. Dragons."
msgstr "{Убийца драконов}\n\nЗначительно увеличивает урон, наносимый выбранным отрядом в бою против драконов."

msgctxt "table.gSpellDesc.38"
msgid "{Blood Lust}\n\nIncreases a unit's attack skill."
msgstr "{Жажда крови}\n\nУвеличивает урон, наносимый выбранным отрядом."

msgctxt "table.gSpellDesc.39"
msgid "{Animate Dead}\n\n'Resurrects' creatures from a damaged or dead undead unit permanently."
msgstr "{Поднять мертвых}\n\nНавсегда \"воскрешает\" из раненных или уничтоженных отрядов нежити."

msgctxt "table.gSpellDesc.4"
msgid "{Teleport}\n\nTeleports the creature you select to any open position on the battlefield."
msgstr "{Телепорт}\n\nМгновенно перемещает выбранный отряд в любую свободную точку на поле боя."

msgctxt "table.gSpellDesc.40"
msgid "{Mirror Image}\n\nCreates an illusionary unit that duplicates one of your existing units.  This illusionary unit does the same damages as the original, but will vanish if it takes any damage."
msgstr "{Фантом}\n\nЗаклинание создает призрачный отряд, который является двойником существующего отряда. Призрачный отряд наносит противнику такой же урон, как и настоящий, но исчезает, если ему был нанесен хотя бы минимальный урон."

msgctxt "table.gSpellDesc.41"
msgid "{Shield}\n\nHalves damage received from ranged attacks for a single unit."
msgstr "{Щит}\n\nВдвое уменьшает урон, получаемый выбранным отрядом от стрелковых атак противника."

msgctxt "table.gSpellDesc.42"
msgid "{Mass Shield}\n\nHalves damage received from ranged attacks for all of your units."
msgstr "{Общий щит}\n\nВдвое уменьшает урон, получаемый всеми отрядами от стрелковых атак противника."

msgctxt "table.gSpellDesc.43"
msgid "{Summon Earth Elemental}\n\nSummons Earth Elementals to fight for your army."
msgstr "{Земной элементал}\n\nЗаклинание вызывает отряд элементалов земли, которые присоединяются к вашей армии."

msgctxt "table.gSpellDesc.44"
msgid "{Summon Air Elemental}\n\nSummons Air Elementals to fight for your army."
msgstr "{Воздушный элементал}\n\nЗаклинание вызывает отряд элементалов воздуха, которые присоединяются к вашей армии."

msgctxt "table.gSpellDesc.45"
msgid "{Summon Fire Elemental}\n\nSummons Fire Elementals to fight for your army."
msgstr "{Огненный элементал}\n\nЗаклинание вызывает отряд элементалов огня, которые присоединяются к вашей армии."

msgctxt "table.gSpellDesc.46"
msgid "{Summon Water Elemental}\n\nSummons Water Elementals to fight for your army."
msgstr "{Водный элементал}\n\nЗаклинание вызывает отряд элеманталов воздуха, которей присоединяются к вашей армии."

msgctxt "table.gSpellDesc.47"
msgid "{Earthquake}\n\nDamages castle walls."
msgstr "{Землетрясение}\n\nНаносит ущерб крепостным стенам."

msgctxt "table.gSpellDesc.48"
msgid "{View Mines}\n\nCauses all mines across the land to become visible."
msgstr "{Показать шахты}\n\nДелает видимыми все шахты на игровой карте."

msgctxt "table.gSpellDesc.49"
msgid "{View Resources}\n\nCauses all resources across the land to become visible."
msgstr "{Показать ресурсы}\n\nПоказывает все ресурсы на игровой карте."

msgctxt "table.gSpellDesc.5"
msgid "{Cure}\n\nRemoves all negative spells cast upon one of your units, and restores up to 5 HP per level of spell power."
msgstr "{Лечение}\n\nНейтрализует все враждебные заклинания, примененные против одного из ваших отрядов и восстанавливает по 5 единиц здоровья в расчете на каждый уровень магических способностей героя."

msgctxt "table.gSpellDesc.50"
msgid "{View Artifacts}\n\nCauses all artifacts across the land to become visible."
msgstr "{Показать артефакты}\n\nДелает видимыми все артефакты на игровой карте."

msgctxt "table.gSpellDesc.51"
msgid "{View Towns}\n\nCauses all towns and castles across the land to become visible."
msgstr "{Показать города}\n\nДелает видимыми все города и замки на игровой карте."

msgctxt "table.gSpellDesc.52"
msgid "{View Heroes}\n\nCauses all Heroes across the land to become visible."
msgstr "{Показать героев}\n\nДелает видимыми всех героев на игровой карте."

msgctxt "table.gSpellDesc.53"
msgid "{View All}\n\nCauses the entire land to become visible."
msgstr "{Показать все}\n\nДелает видимыми все объекты на игровой карте."

msgctxt "table.gSpellDesc.54"
msgid "{Identify Hero}\n\nAllows the caster to view detailed information on enemy Heroes."
msgstr "{Опознать героев}\n\nПозволяет получить подробную информацию о героях противника."

msgctxt "table.gSpellDesc.55"
msgid "{Summon Boat}\n\nSummons the nearest unoccupied, friendly boat to an adjacent shore location.  A friendly boat is one which you just built or were the most recent player to occupy."
msgstr "{Призвать корабль}\n\nПеремещает ваш ближайший незанятый корабль в ближайшую к вам точку побережья. Вашим считается корабль, который вы только что построили, либо тот, на котором вы плавали последним."

msgctxt "table.gSpellDesc.56"
msgid "{Dimension Door}\n\nAllows the caster to magically transport to a nearby location."
msgstr "{Портал}\n\nПереносит героя в расположенную поблизости точку на карте."

msgctxt "table.gSpellDesc.57"
msgid "{Town Gate}\n\nReturns the caster to any town or castle currently owned."
msgstr "{Врата города}\n\nПереносит героя в ближайший принадлежащий игроку город или замок."

msgctxt "table.gSpellDesc.58"
msgid "{Town Portal}\n\nReturns the hero to the town or castle of choice, provided it is controlled by you."
msgstr "{Портал города}\n\nПереносит героя в принадлежащий игроку город или замок по его выбору."

msgctxt "table.gSpellDesc.59"
msgid "{Visions}\n\n Visions predicts the likely outcome of an encounter with a neutral army camp."
msgstr "{Виденье}\n\nЭто заклинание позволяет предсказать вероятный исход встречи с нейтральной армией."

msgctxt "table.gSpellDesc.6"
msgid "{Mass Cure}\n\nRemoves all negative spells cast upon your forces, and restores up to 5 HP per level of spell power, per creature."
msgstr "{Общее лечение}\n\nНейтрализует враждебные заклинания, примененные против всех ваших отрядов и восстанавливает по 5 единиц здоровья у каждого существа за каждый уровень магических способностей героя."

msgctxt "table.gSpellDesc.60"
msgid "{Haunt}\n\nHaunts a mine you control with Ghosts.  This mine stops producing resources.  (If I can't keep it, nobody will!)"
msgstr "{Запустение}\n\nНаводняет принадлежащую игроку шахту призраками, после чего она перестает производить ресурсы. (Не доставайся же ты никому!)"

msgctxt "table.gSpellDesc.61"
msgid "{Set Earth Guardian}\n\nSets Earth Elementals to guard a mine against enemy armies."
msgstr "{Стража земли}\n\nОтряд земных элементалов охраняет шахту от нападения армий противника."

msgctxt "table.gSpellDesc.62"
msgid "{Set Air Guardian}\n\nSets Air Elementals to guard a mine against enemy armies."
msgstr "{Стража воздуха}\n\nОтряд воздушных элементалов охраняет шахту от нападения армий противника."

msgctxt "table.gSpellDesc.63"
msgid "{Set Fire Guardian}\n\nSets Fire Elementals to guard a mine against enemy armies."
msgstr "{Стража огня}\n\nОтряд огненных элементалов охраняет шахту от нападения армий противника."

msgctxt "table.gSpellDesc.64"
msgid "{Set Water Guardian}\n\nSets Water Elementals to guard a mine against enemy armies."
msgstr "{Стража воды}\n\nОтряд водных элементалов охраняет шахту от нападения армий противника."

msgctxt "table.gSpellDesc.7"
msgid "{Resurrect}\n\nResurrects creatures from a damaged or dead unit until end of combat."
msgstr "{Воскрешение}\n\nДо конца сражения воскрешает воинов в отряде, которому был нанесен урон."

msgctxt "table.gSpellDesc.8"
msgid "{Resurrect True}\n\nResurrects creatures from a damaged or dead unit permanently."
msgstr "{Истинное воскрешение}\n\nНавсегда воскрешает воинов в отряде, которому был нанесен урон."

msgctxt "table.gSpellDesc.9"
msgid "{Haste}\n\nIncreases the speed of any creature by two."
msgstr "{Ускорение}\n\nУвеличивает дальность передвижения любого отряда на 2 единицы."

