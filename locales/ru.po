#: src/SOURCE/ADVMGR.cpp
msgctxt "system.video.insufficient_memory"
msgid "You don't have enough memory for non-interlaced video."
msgstr "Недостаточно памяти для воспроизведения видео без чересстрочной развертки."

#: src/SOURCE/CURSOR.cpp
#, c-format
