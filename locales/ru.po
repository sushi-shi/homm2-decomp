msgctxt "table.cWinComError.0"
msgid "Communications error on function '%s'\n\nWin95 Error Code: %d\nWin95 Error Meaning: %s\n\n"
msgstr "Ошибка передачи данных при выполнении функции %s\n\nКод ошибки: %d\nЗначение ошибки: %s\n\n"

msgctxt "table.cWinComError.1"
msgid "Suggested solutions:"
msgstr "Предлагаемые меры устранения ошибки:"

msgctxt "table.cWinComError.2"
msgid "\n  1) Make sure all cables are firmly connected."
msgstr "\n1) Убедитесь в надежности подсоединения кабелей."

msgctxt "table.cWinComError.3"
msgid "\n  2) Reboot computer."
msgstr "\n2) Перезагрузите компьютер."

msgctxt "table.cWinComError.4"
msgid "\n  3) Check to make sure you have the correct COM port setting in 'CONFIG'. (The 3rd button down on the screen where you choose Host or Guest.)"
msgstr "\n3) Убедитесь в том, что в 'CONFIG' задан правильный COM порт. (Третья кнопка на экране, где вы выбираете Хозяина или Гостя.)"

msgctxt "table.cWinComError.5"
msgid "\n  4) Consider lowering the BAUD rate in 'CONFIG' to 19200 or 9600."
msgstr "\n4) Попробуйте уменьшить скорость передачи данных в 'CONFIG' до 19200 или до 9600."

