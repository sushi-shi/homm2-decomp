msgctxt "table.cBattleResults.2"
msgid "A glorious victory!"
msgstr "Великая победа!"

msgctxt "table.cBattleResults.3"
msgid "\n\nFor valor in combat, %s receives %d experience"
msgstr "\n\nЗа мужество, проявленное в бою, %s получает %d оч. опыта."

msgctxt "table.cBattleResults.4"
msgid "%s surrenders to the enemy, and departs in shame."
