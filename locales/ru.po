msgid "{COM 1}\n\nUse COM Port 1 for the direct connection."
msgstr "{COM 1}\n\nИспользовать для прямого соединения порт COM 1."

msgctxt "table.gSetupDCComPortHelp.1"
msgid "{COM 2}\n\nUse COM Port 2 for the direct connection."
