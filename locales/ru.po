msgctxt "table.gBuildingInfoSpecial.0"
msgid "The Fortifications increase the toughness of the walls, increasing the number of turns it takes to knock them down."
msgstr "Укрепления увеличивают прочность стен, увеличивая число раундов, необходимых для полного их разрушения."

msgctxt "table.gBuildingInfoSpecial.1"
msgid "The Coliseum provides inspiring spectacles to defending troops, raising their morale by two during combat."
msgstr "Представления, проходимые в Колизее, увеличивают мораль защитников замка на 2 единицы."

msgctxt "table.gBuildingInfoSpecial.2"
msgid "The Rainbow increases the luck of the defending units by two."
msgstr "Радуга увеличивает удачу защитников замка на 2 единицы."

msgctxt "table.gBuildingInfoSpecial.3"
msgid "The Dungeon increases the income of the town by 500 / day."
msgstr "Подземелье увеличивает доход города на 500 золотых в день."

msgctxt "table.gBuildingInfoSpecial.4"
msgid "The Library increases the number of spells in the Guild by one for each level of the guild."
msgstr "Библиотека увеличивает число заклинаний, доступных в Гильдии на 1 на каждый ее этаж."

msgctxt "table.gBuildingInfoSpecial.5"
msgid "The Storm adds +2 to the power of spells of a defending spell caster."
msgstr "Шторм добавляет +2 единицы к силе заклинаний защитников замка."

msgctxt "table.gCPanelHelp.0"
msgid "Start a single or multi-player game."
msgstr "Начать одиночную или сетевую игру."

msgctxt "table.gCPanelHelp.1"
msgid "Load a previously saved game."
msgstr "Загрузить сохраненную игру."

msgctxt "table.gCPanelHelp.2"
msgid "Save the current game."
msgstr "Сохранить игру."

msgctxt "table.gCPanelHelp.3"
msgid "Quit out of Heroes of Might and Magic II."
msgstr "Выйти из Героев Меча и Магии II."

msgctxt "table.gCPanelHelp.4"
msgid "Exit this menu without doing anything."
msgstr "Закрыть меню, ничего не делая."

msgctxt "table.gCSPanelHelp.0"
msgid "{OK}\n\nExit this menu."
msgstr "{ОК}\n\nЗакрыть это меню."

msgctxt "table.gCSPanelHelp.1"
msgid "{Speed}\n\nSet the speed of combat actions and animations."
msgstr "{Скорость}\n\nУстановить скорость действий и анимации воинов в бою."

msgctxt "table.gCSPanelHelp.2"
msgid "{Monster Info}\n\nToggle the monster info window, which shows information on the active and targeted monsters."
msgstr "{Информация о воине}\n\nВключить или выключить отображение окна с информацией о выбранном и атакуемом воине."

msgctxt "table.gCSPanelHelp.3"
msgid "{Auto Combat\nSpell Casting}\n\nToggle whether or not the computer will cast spells for you when auto combat is on.  (Note: This does not affect spell casting for computer players in any way, nor does it affect quick combat.)"
msgstr "{Магия в автобое}\n\nЕсли эта опция включена, ваш герой будет использовать заклинания во время автобоя. (Примечание: Эта опция не влияет на использование заклинаний компьютерными игроками, и на быстрый бой.)"

msgctxt "table.gCSPanelHelp.4"
msgid "{Grid}\n\nToggle the hex grid on or off.  The hex grid always underlies movement, even if turned off.  This switch only determines if the grid is visible."
msgstr "{Сетка}\n\nВключает или выключает отображение сетки. Все перемещения на поле боя происходят по гексагональной сетке, даже если ее отображение отключено."

msgctxt "table.gCSPanelHelp.5"
msgid "{Shadow Movement}\n\nToggle on or off a shadowing system showing where your creatures can move and attack.  When this is turned on, there is a slight performance cost, most noticeable on 486 computers."
msgstr "{Затенение сетки}\n\nВключает или выключает режим обозначения возможной дальности передвижения выбранного отряда воинов."

msgctxt "table.gCSPanelHelp.6"
msgid "{Shadow Cursor}\n\nToggle on or off a shadowing system showing where the hex grid that the mouse cursor is currently over is shadowed.  When this is turned on, there is a slight performance cost, most noticeable on 486 computers."
msgstr "{Курсор с тенью}\n\nВключает или выключает отрисовку тени от курсора на сетке координат."

