msgctxt "table.gAPanelHelp.0"
msgid "View the entire world."
msgstr "Осмотреть весь мир."

msgctxt "table.gAPanelHelp.1"
msgid "View the obelisk puzzle."
msgstr "Посмотреть головоломку."

msgctxt "table.gAPanelHelp.2"
msgid "View information on the scenario you are currently playing."
msgstr "Показать информацию о сценарии, на котором идет игра."

msgctxt "table.gAPanelHelp.3"
msgid "Dig for the Ultimate Artifact."
msgstr "Копать в поисках Великого артефакта."

msgctxt "table.gAPanelHelp.4"
msgid "Exit this menu without doing anything."
msgstr "Закрыть это меню."

msgctxt "table.gAdvMenuHelp.0"
msgid "{Next Hero}\n\nSelect the next Hero."
msgstr "{Следующий герой}\n\nВыбрать следующего героя."

msgctxt "table.gAdvMenuHelp.1"
msgid "{Continue Movement}\n\nContinue the Hero's movement along the current path."
msgstr "{Продолжить движение}\n\nПродолжить движение героя по намеченному пути."

msgctxt "table.gAdvMenuHelp.2"
msgid "{Kingdom Summary}\n\nView a summary of your kingdom."
msgstr "{Обзор королевства}\n\nОсмотреть ваши владения."

msgctxt "table.gAdvMenuHelp.3"
msgid "{End Turn}\n\nEnd your turn and let the computer take its turn."
msgstr "{Окончить ход}\n\nОкончить ход и передать управление компьютеру."

msgctxt "table.gAdvMenuHelp.4"
msgid "{Adventure Options}\n\nBring up the adventure options menu."
msgstr "{Игровые действия}\n\nОткрыть окно доступных игровых действий."

msgctxt "table.gAdvMenuHelp.5"
msgid "{File Options}\n\nBring up the file options menu, allowing you to load, save etc."
msgstr "{Окно файлов}\n\nОткрывает меню, где вы можете загружать или сохранять игры."

msgctxt "table.gAdvMenuHelp.6"
msgid "{System Options}\n\nBring up the system options menu, allowing you to customize your game."
msgstr "{Системные настройки}\n\nОткрывает окно системных настроек, позволяющих настроить игру."

msgctxt "table.gAdvMenuHelp.7"
msgid "{Cast Spell}\n\nCast an adventure spell."
msgstr "{Направить заклинание}\n\nНаправить заклинание на стратегической карте."

