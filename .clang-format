# Rust-like clang-format style for the reconstructed C++. Whitespace-only =>
# matching-NEUTRAL. Apply with clang-format using the repo .clang-format.
---
Language: Cpp
BasedOnStyle: LLVM
# c++03 is clang-format's OLDEST standard; any pre-C++11 value keeps `> >` (not
# `>>`), which the pre-C++98 MSVC 5.0 parser needs. Not a claim that we're c++03.
Standard: c++03

# --- indentation -----------------------------------------------------------
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
AccessModifierOffset: -4
NamespaceIndentation: All
IndentCaseLabels: true
IndentPPDirectives: None
IndentExternBlock: Indent

# --- line width ------------------------------------------------------------
ColumnLimit: 100
MaxEmptyLinesToKeep: 1

# --- braces: attach everything, like Rust ----------------------------------
BreakBeforeBraces: Attach
# InsertBraces inserts TOKENS: it broke a statement-macro + else pairing in
# Bzip.cpp and voids the whitespace-only matching-neutrality contract above.
InsertBraces: false
Cpp11BracedListStyle: true
InsertTrailingCommas: Wrapped

# nothing collapses onto one line (rustfmt expands bodies)
AllowShortFunctionsOnASingleLine: Empty
AllowShortBlocksOnASingleLine: Never
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false

# --- pointers / references bind to the type (Rust `&T`) ---------------------
DerivePointerAlignment: false
PointerAlignment: Left
ReferenceAlignment: Left

# --- spacing ---------------------------------------------------------------
SpaceBeforeParens: ControlStatements
SpaceAfterTemplateKeyword: false
SpacesBeforeTrailingComments: 1

# --- wrapping: BlockIndent; one-per-line when wrapped (no bin-packing) -------
# Data tables (e.g. the Font GUIDs) opt out with `// clang-format off/on`.
AlignAfterOpenBracket: BlockIndent
BinPackArguments: false
BinPackParameters: false
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false
PackConstructorInitializers: NextLine
BreakConstructorInitializers: BeforeColon
BreakBeforeBinaryOperators: NonAssignment

# --- comments not rewrapped; trailing comments column-aligned ---------------
ReflowComments: Never
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 0
SortIncludes: Never

# --- project macros (include/va.h) -----------------------------------------
# VA/VAU/SYMBOL annotate the FOLLOWING function definition and must sit on
# their own line: the defs-declared gate reads the signature from the line
# after VA(...). StatementMacros forces that break. DATA annotates a global
# definition on the SAME line (the globals-data gate matches line-wise), so it
# is attribute-like; BreakAfterAttributes: Leave preserves that placement.
StatementMacros:
  - VA
  - VAU
  - SYMBOL
  - H2_ENUM_FLAGS
  - H2_ENUM_STEPPED
# Teach the formatter that the enum macros open and close a brace block so
# enumerators format exactly like a native enum body.
Macros:
  - H2_ENUM_CLASS_BEGIN(name)=enum name {
  - H2_ENUM_CLASS_BEGIN_T(name, storage)=enum name {
  - H2_ENUM_CLASS_BEGIN_SPLIT(name, storage)=enum name {
  - H2_ENUM_BEGIN(name)=enum name {
  - H2_ENUM_CLASS_END(name)=};
  - H2_ENUM_CLASS_END_T(name, storage)=};
  - H2_ENUM_CLASS_END_SPLIT(name, storage)=};
  - H2_ENUM_END(name)=};
AttributeMacros:
  - OVERRIDE
  - DATA
BreakAfterAttributes: Leave
...
