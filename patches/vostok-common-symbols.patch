@@ -0,0 +1,167 @@
+use std::collections::HashSet;
+use std::path::Path;
+
+const HEADER: &str = "object\tname\tsize";
+
+#[derive(Clone, Copy, Debug)]
+pub struct CommonSymbol {
+    pub object: &'static [u8],
+    pub name: &'static [u8],
+    pub size: u64,
+}
+
+#[derive(Default)]
+pub struct CommonSymbolManifest {
+    symbols: Vec<CommonSymbol>,
+}
+
+impl CommonSymbolManifest {
+    pub fn load(path: Option<&Path>) -> anyhow::Result<Self> {
+        let Some(path) = path else {
+            return Ok(Self::default());
+        };
+        Self::parse(&std::fs::read(path)?, path)
+    }
+
+    fn parse(bytes: &[u8], path: &Path) -> anyhow::Result<Self> {
+        let text = std::str::from_utf8(bytes)?;
+        let mut symbols = Vec::new();
+        let mut seen = HashSet::new();
+        let mut saw_header = false;
+        for (line_index, line) in text.lines().enumerate() {
+            let line_number = line_index + 1;
+            if line.is_empty() || line.starts_with('#') {
+                continue;
+            }
+            if !saw_header {
+                if line != HEADER {
+                    anyhow::bail!(
+                        "{}:{}: invalid COMMON symbol manifest header",
+                        path.display(),
+                        line_number
+                    );
+                }
+                saw_header = true;
+                continue;
+            }
+            if line == HEADER {
+                anyhow::bail!(
+                    "{}:{}: duplicate COMMON symbol manifest header",
+                    path.display(),
+                    line_number
+                );
+            }
+            let fields = line.split('\t').collect::<Vec<_>>();
+            if fields.len() != 3 {
+                anyhow::bail!(
+                    "{}:{}: expected exactly three tab-separated columns",
+                    path.display(),
+                    line_number
+                );
+            }
+            let object = normalize_object(fields[0], path, line_number)?;
+            let name = fields[1].as_bytes();
+            if name.is_empty() || name.iter().any(|byte| byte.is_ascii_control()) {
+                anyhow::bail!(
+                    "{}:{}: COMMON symbol name must be non-empty and printable",
+                    path.display(),
+                    line_number
+                );
+            }
+            let size = parse_number(fields[2])?;
+            if size == 0 {
+                anyhow::bail!(
+                    "{}:{}: COMMON symbol size must be non-zero",
+                    path.display(),
+                    line_number
+                );
+            }
+            let name = name.to_vec().leak();
+            if !seen.insert((object, &*name)) {
+                anyhow::bail!(
+                    "{}:{}: duplicate COMMON identity in object",
+                    path.display(),
+                    line_number
+                );
+            }
+            symbols.push(CommonSymbol {
+                object,
+                name,
+                size: size as u64,
+            });
+        }
+        if !saw_header {
+            anyhow::bail!("{}: missing COMMON symbol manifest header", path.display());
+        }
+        symbols.sort_unstable_by(|left, right| {
+            (left.object, left.name).cmp(&(right.object, right.name))
+        });
+        Ok(Self { symbols })
+    }
+
+    pub fn symbols(&self) -> &[CommonSymbol] {
+        &self.symbols
+    }
+}
+
+fn normalize_object(
+    value: &str,
+    path: &Path,
+    line_number: usize,
+) -> anyhow::Result<&'static [u8]> {
+    let object = value.replace('/', "\\");
+    if object.contains(':')
+        || object
+            .split('\\')
+            .any(|part| part.is_empty() || part == "." || part == "..")
+    {
+        anyhow::bail!(
+            "{}:{}: object path must be relative and normalized",
+            path.display(),
+            line_number
+        );
+    }
+    Ok(object.into_bytes().leak())
+}
+
+fn parse_number(value: &str) -> anyhow::Result<usize> {
+    Ok(match value
+        .strip_prefix("0x")
+        .or_else(|| value.strip_prefix("0X"))
+    {
+        Some(hex) => usize::from_str_radix(hex, 16),
+        None => value.parse(),
+    }?)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_per_object_common_symbols() {
+        let manifest = CommonSymbolManifest::parse(
+            b"object\tname\tsize\nSOURCE/Test.c\t??_Bguard\t0x1\n",
+            Path::new("test.tsv"),
+        )
+        .unwrap();
+        let symbol = manifest.symbols()[0];
+        assert_eq!(symbol.object, b"SOURCE\\Test.c");
+        assert_eq!(symbol.name, b"??_Bguard");
+        assert_eq!(symbol.size, 1);
+    }
+
+    #[test]
+    fn rejects_zero_size_and_duplicate_identity() {
+        assert!(CommonSymbolManifest::parse(
+            b"object\tname\tsize\nA.c\tguard\t0\n",
+            Path::new("test.tsv"),
+        )
+        .is_err());
+        assert!(CommonSymbolManifest::parse(
+            b"object\tname\tsize\nA.c\tguard\t1\nA.c\tguard\t1\n",
+            Path::new("test.tsv"),
+        )
+        .is_err());
+    }
+}
