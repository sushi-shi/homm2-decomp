+    #[test]
+    fn generic_data_does_not_append_to_crt_topology_section() {
+        let sections = [
+            DataSection {
+                object: b"fixture.c",
+                ordinal: 1,
+                name: b".CRT$XCU",
+                rva: Some(0x10),
+                size: 4,
+                alignment: 4,
+                characteristics: 0xc030_0040,
+                checksum: 0,
+                comdat_selection: ComdatSelection::None,
+                associative_ordinal: None,
+                storage: Some(SectionStorage::Data),
+            },
+            DataSection {
+                object: b"fixture.c",
+                ordinal: 2,
+                name: b".data",
+                rva: Some(0x20),
+                size: 4,
+                alignment: 4,
+                characteristics: 0xc030_0040,
+                checksum: 0,
+                comdat_selection: ComdatSelection::None,
+                associative_ordinal: None,
+                storage: Some(SectionStorage::Data),
+            },
+        ];
+        let mut image = vec![0_u8; 0x30];
+        image[0x10..0x14].copy_from_slice(b"crt!");
+        image[0x20..0x24].copy_from_slice(b"data");
+        let empty = crate::SecInfo {
+            rva: 0,
+            va: 0,
+            size: 0,
+            id: 2,
+            data: &[],
+        };
+        let data = crate::SecInfo {
+            rva: 0,
+            va: 0,
+            size: image.len(),
+            id: 3,
+            data: &image,
+        };
+        let mut output =
+            ObjectFile::with_sections(&sections, empty, data, &image, false).unwrap();
+        let data_section_id = output.data_section();
+        output
+            .object
+            .append_section_data(data_section_id, b"tail", 1);
+
+        let bytes = output.object.write().unwrap();
+        let object = object::File::parse(bytes.as_slice()).unwrap();
+        assert_eq!(
+            object.section_by_name(".CRT$XCU").unwrap().data().unwrap(),
+            b"crt!"
+        );
+        assert_eq!(
+            object.section_by_name(".data").unwrap().data().unwrap(),
+            b"datatail"
+        );
+    }
