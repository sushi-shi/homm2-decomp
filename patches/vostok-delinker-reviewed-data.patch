@@ -0,0 +1,163 @@
+use pdb2::RawString;
+
+use std::collections::HashSet;
+use std::path::Path;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum DataStorage {
+    Data,
+    Rdata,
+    Bss,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct DataDefinition {
+    pub name: RawString<'static>,
+    pub object: &'static [u8],
+    pub rva: usize,
+    pub size: usize,
+    pub storage: DataStorage,
+    pub alignment: u64,
+}
+
+#[derive(Default)]
+pub struct DataManifest {
+    definitions: Vec<DataDefinition>,
+    names: HashSet<&'static [u8]>,
+}
+
+impl DataManifest {
+    pub fn load(path: Option<&Path>) -> anyhow::Result<Self> {
+        let Some(path) = path else {
+            return Ok(Self::default());
+        };
+        let bytes = std::fs::read(path)?;
+        let mut definitions = Vec::new();
+        let mut names = HashSet::new();
+        let mut rvas = HashSet::new();
+        for (line_index, line) in bytes.split(|byte| *byte == b'\n').enumerate() {
+            let line = line.strip_suffix(b"\r").unwrap_or(line);
+            if line.is_empty() || line.starts_with(b"#") {
+                continue;
+            }
+            let columns = line.split(|byte| *byte == b'\t').collect::<Vec<_>>();
+            if columns.first() == Some(&b"name".as_slice()) {
+                continue;
+            }
+            if columns.len() < 7 {
+                anyhow::bail!("{}:{}: expected seven tab-separated columns", path.display(), line_index + 1);
+            }
+            let name: &'static [u8] = columns[0].to_vec().leak();
+            let object = std::str::from_utf8(columns[1])?.replace('/', "\\");
+            let rva = parse_number(columns[2])?;
+            let size = parse_number(columns[3])?;
+            if name.is_empty() || object.is_empty() || size == 0 {
+                anyhow::bail!("{}:{}: empty name/object or zero size", path.display(), line_index + 1);
+            }
+            if rva.checked_add(size).is_none() {
+                anyhow::bail!("{}:{}: data extent overflows the address space", path.display(), line_index + 1);
+            }
+            if object.split('\\').any(|part| part.is_empty() || part == "." || part == "..") {
+                anyhow::bail!("{}:{}: object path must be relative and normalized", path.display(), line_index + 1);
+            }
+            let storage = match columns[4] {
+                b"data" => DataStorage::Data,
+                b"rdata" => DataStorage::Rdata,
+                b"bss" => DataStorage::Bss,
+                value => anyhow::bail!(
+                    "{}:{}: unsupported storage {}",
+                    path.display(),
+                    line_index + 1,
+                    String::from_utf8_lossy(value)
+                ),
+            };
+            let alignment = parse_number(columns[5])? as u64;
+            if alignment == 0 || !alignment.is_power_of_two() {
+                anyhow::bail!("{}:{}: alignment is not a power of two", path.display(), line_index + 1);
+            }
+            if !names.insert(name) || !rvas.insert(rva) {
+                anyhow::bail!("{}:{}: duplicate data name or RVA", path.display(), line_index + 1);
+            }
+            let object: &'static [u8] = object.into_bytes().leak();
+            definitions.push(DataDefinition {
+                name: RawString::from(name),
+                object,
+                rva,
+                size,
+                storage,
+                alignment,
+            });
+        }
+        definitions.sort_by_key(|definition| (definition.object, definition.rva));
+        let mut by_rva = definitions.clone();
+        by_rva.sort_by_key(|definition| definition.rva);
+        for pair in by_rva.windows(2) {
+            if pair[0].rva.checked_add(pair[0].size).unwrap() > pair[1].rva {
+                anyhow::bail!("overlapping reviewed data definitions");
+            }
+        }
+        Ok(Self { definitions, names })
+    }
+
+    pub fn definitions(&self) -> &[DataDefinition] {
+        &self.definitions
+    }
+
+    pub fn contains_name(&self, name: &[u8]) -> bool {
+        self.names.contains(name)
+    }
+
+    pub fn owner_for_rva(&self, rva: usize) -> Option<DataDefinition> {
+        self.definitions.iter().copied().find(|definition| {
+            definition.rva <= rva && rva - definition.rva < definition.size
+        })
+    }
+}
+
+fn parse_number(value: &[u8]) -> anyhow::Result<usize> {
+    let value = std::str::from_utf8(value)?;
+    let result = match value.strip_prefix("0x") {
+        Some(hex) => usize::from_str_radix(hex, 16),
+        None => value.parse(),
+    }?;
+    Ok(result)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_reviewed_definition() {
+        let path = std::env::temp_dir().join("vostok-data-manifest-test.tsv");
+        std::fs::write(
+            &path,
+            "name\tobject\trva\tsize\tstorage\talignment\tprovenance\n_table\tengine/world.c\t0xf0000\t0x20\tdata\t0x4\treviewed\n",
+        )
+        .unwrap();
+        let manifest = DataManifest::load(Some(&path)).unwrap();
+        let definition = manifest.definitions()[0];
+        assert_eq!(definition.name.as_bytes(), b"_table");
+        assert_eq!(definition.object, b"engine\\world.c");
+        assert_eq!(definition.rva, 0xf0000);
+        assert_eq!(definition.size, 0x20);
+        assert_eq!(definition.storage, DataStorage::Data);
+        assert_eq!(definition.alignment, 4);
+        assert!(manifest.contains_name(b"_table"));
+        assert_eq!(manifest.owner_for_rva(0xf0004).unwrap().name.as_bytes(), b"_table");
+        std::fs::remove_file(path).unwrap();
+    }
+
+    #[test]
+    fn rejects_overlapping_definitions() {
+        let path = std::env::temp_dir().join("vostok-overlapping-data-manifest-test.tsv");
+        std::fs::write(
+            &path,
+            "name\tobject\trva\tsize\tstorage\talignment\tprovenance\na\tu.c\t0x100\t0x20\tdata\t4\ttest\nb\tu.c\t0x110\t4\tdata\t4\ttest\n",
+        )
+        .unwrap();
+        let error = DataManifest::load(Some(&path)).err().unwrap().to_string();
+        assert!(error.contains("overlapping"));
+        std::fs::remove_file(path).unwrap();
+    }
+}
