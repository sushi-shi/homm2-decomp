+    #[test]
+    fn test_infer_data_alias_sizes() {
+        let sections = vec![Section { size: 16, kind: SectionKind::Data, ..Default::default() }];
+        let mut symbols = vec![
+            Symbol {
+                name: ".data".to_string(),
+                kind: SymbolKind::Section,
+                section: Some(0),
+                ..Default::default()
+            },
+            Symbol {
+                name: "alias_a".to_string(),
+                kind: SymbolKind::Object,
+                section: Some(0),
+                ..Default::default()
+            },
+            Symbol {
+                name: "alias_b".to_string(),
+                kind: SymbolKind::Object,
+                section: Some(0),
+                ..Default::default()
+            },
+            Symbol {
+                name: "next".to_string(),
+                address: 8,
+                kind: SymbolKind::Object,
+                section: Some(0),
+                ..Default::default()
+            },
+        ];
+
+        infer_symbol_sizes(ArchDummy::new().as_ref(), &mut symbols, &sections).unwrap();
+
+        assert_eq!(symbols[0].size, 0);
