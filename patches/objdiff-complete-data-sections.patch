+fn diff_symbol_less_data_section_bytes() {
+    let diff_config = diff::DiffObjConfig {
+        combine_data_sections: true,
+        combine_text_sections: true,
+        ..Default::default()
+    };
+    let mut target = obj::read::parse(
+        include_object!("data/x86/rtest.obj"),
+        &diff_config,
+        diff::DiffSide::Target,
+    )
+    .unwrap();
+    let mut base =
+        obj::read::parse(include_object!("data/x86/rtest.obj"), &diff_config, diff::DiffSide::Base)
+            .unwrap();
+    let target_section_idx = target
+        .sections
+        .iter()
+        .position(|s| s.name == ".data" && s.kind == obj::SectionKind::Data)
+        .unwrap();
+    let base_section_idx = base
+        .sections
+        .iter()
+        .position(|s| s.name == ".data" && s.kind == obj::SectionKind::Data)
+        .unwrap();
+
+    for symbol in &mut target.symbols {
+        if symbol.section == Some(target_section_idx) {
+            symbol.flags |= obj::SymbolFlag::Hidden;
+        }
+    }
+    for symbol in &mut base.symbols {
+        if symbol.section == Some(base_section_idx) {
+            symbol.flags |= obj::SymbolFlag::Hidden;
+        }
+    }
+    target.sections[target_section_idx].relocations.clear();
+    base.sections[base_section_idx].relocations.clear();
+    *base.sections[base_section_idx].data.0.last_mut().unwrap() ^= 1;
+
+    let result = diff::diff_objs(
+        Some(&target),
+        Some(&base),
+        None,
+        &diff_config,
+        &diff::MappingConfig::default(),
+    )
+    .unwrap();
+    let section_diff = &result.left.unwrap().sections[target_section_idx];
+    assert!(section_diff.match_percent.unwrap() < 100.0);
+    assert!(section_diff.data_diff.iter().any(|d| d.kind != diff::DataDiffKind::None));
+}
