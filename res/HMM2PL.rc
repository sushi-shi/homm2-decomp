// HMM2PL.rc - retail HMM2PL.exe's resources as SOURCE, all 10 of them.
//
// Compiled by the era resource compiler (RC.EXE 5.00 + RCDLL.DLL) under
// `homm2 link --rsrc` / `--transform`; the gate recompiles this file and
// byte-compares every payload (type, name, language, bytes, order)
// against the retail image, total coverage both directions.
//
// Only documented rc.exe grammar is used. Statement order IS retail
// payload order. Cyrillic (cp1251) is carried as \ooo octal escapes
// under #pragma code_page(1251), so this file is pure ASCII. heroes.ico
// is the one retail-extracted binary: the 32x32 16-color program icon.

#pragma code_page(1251)

LANGUAGE 0x19, 0x1 // LANG_RUSSIAN, SUBLANG_DEFAULT (1049)

HEROES ICON DISCARDABLE "heroes.ico"

HEROES DIALOG DISCARDABLE 22, 17, 144, 75
STYLE 0x800000C0 // WS_POPUP | DS_MODALFRAME | DS_SETFONT
FONT 8, "System"
BEGIN
    ICON            "HEROES", -1, 8, 17, 18, 20
    CTEXT           "\303\345\360\356\350 \314\345\367\340 \350 \314\340\343\350\350 2", -1, 22, 5, 101, 8
    CTEXT           "\302\345\360\361\350\377 2.1 \360\363\361\361\352\340\377", -1, 51, 23, 42, 8
    CTEXT           "Copyright 1995-1997, New World Computing. 2003 \301\363\352\340.", -1, 7, 40, 132, 17
    DEFPUSHBUTTON   "\316\312", 1, 53, 59, 32, 14, 0x20000 // + WS_GROUP
END

