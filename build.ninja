ninja_required_version = 1.10
builddir = build
cxx = clang++
dlltool = llvm-dlltool
cxxflags = --target=i686-w64-windows-gnu -std=gnu++20 -O0 -mno-sse -mno-sse2 -mfpmath=387 -fms-extensions -fsjlj-exceptions -w -D_X86_ -DWIN32 -D_WINDOWS -D_MT -Dregister= -Wno-write-strings -Wno-narrowing -Wno-deprecated-enum-enum-conversion -Wno-deprecated-enum-float-conversion -Iinclude -Ivendor/miles-3.6 -Ivendor/smacker-3.0g -Ivendor/wing-1.0
ldflags = --target=i686-w64-windows-gnu -fuse-ld=lld -mwindows -fsjlj-exceptions -static -static-libgcc -static-libstdc++
system_libs = -lkernel32 -luser32 -lgdi32 -lwinmm -lws2_32 -lddraw -ldplayx -ladvapi32 -lole32 -luuid -lcomdlg32 -lshell32 -lnetapi32
runtime_libs = -Wl,--start-group -lstdc++ -lgcc_eh -lgcc -lmcfgthread -lntdll -Wl,--end-group

rule mkdir
  command = mkdir -p $out
  restat = 1

rule cxx
  command = $cxx $cxxflags -MMD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CXX $in

rule implib
  command = $dlltool -m i386 $dlltool_flags -d $in -l $out
  description = IMPLIB $in

rule link
  command = $cxx $ldflags -o $out $in $system_libs $runtime_libs
  description = LINK $out

build $builddir/obj: mkdir
build $builddir/imports: mkdir
build $builddir/obj/BASE_BASEMGR.o: cxx src/BASE/BASEMGR.cpp || $builddir/obj
build $builddir/obj/BASE_BITMAP.o: cxx src/BASE/BITMAP.cpp || $builddir/obj
build $builddir/obj/BASE_BITS.o: cxx src/BASE/BITS.cpp || $builddir/obj
build $builddir/obj/BASE_BORDER.o: cxx src/BASE/BORDER.cpp || $builddir/obj
build $builddir/obj/BASE_BUTTON.o: cxx src/BASE/BUTTON.cpp || $builddir/obj
build $builddir/obj/BASE_Blur.o: cxx src/BASE/Blur.cpp || $builddir/obj
build $builddir/obj/BASE_Bzip.o: cxx src/BASE/Bzip.cpp || $builddir/obj
build $builddir/obj/BASE_DIMMER.o: cxx src/BASE/DIMMER.cpp || $builddir/obj
build $builddir/obj/BASE_EXEC.o: cxx src/BASE/EXEC.cpp || $builddir/obj
build $builddir/obj/BASE_FONT.o: cxx src/BASE/FONT.cpp || $builddir/obj
build $builddir/obj/BASE_ICON.o: cxx src/BASE/ICON.cpp || $builddir/obj
build $builddir/obj/BASE_ICONWDGT.o: cxx src/BASE/ICONWDGT.cpp || $builddir/obj
build $builddir/obj/BASE_INPUTMGR.o: cxx src/BASE/INPUTMGR.cpp || $builddir/obj
build $builddir/obj/BASE_Icon2b.o: cxx src/BASE/Icon2b.cpp || $builddir/obj
