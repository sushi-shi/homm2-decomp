# clangd over the GENERATED clang compilation database. ADDITIVE editor tooling
# (go-to-def / completion / hover / diagnostics) that runs ALONGSIDE the real
# matching build - it does NOT drive or verify it. The Wine VC6 SP5 build
# (scripts/homm2/graph/cc.py) is the sole verdict on correctness; clang is
# only a READER of this VC6-dialect code.
#
# Generate the DB first:  homm2 clangd
CompileFlags:
  CompilationDatabase: build/clangd
  Add:
    # Emulate VC6 (cl 12.00 == _MSC_VER 1200), as homm2.lsp.compdb does, so the
    # era CRT headers take their MSVC-version codepaths. Add runs after the
    # database's flags, so this value must agree with it.
    - --target=i386-pc-windows-msvc
    - -fms-compatibility-version=12.00
    - -fms-extensions
    - -fdelayed-template-parsing
    - -ferror-limit=0
    # VC6 accepts `char *p = "literal";` (only deprecated in C++98). The real
    # cl build accepts it, so silence clang's -Wwritable-strings false positive.
    - -Wno-writable-strings
Diagnostics:
  Suppress:
    - -Wmicrosoft
    - -Wignored-pragmas
    - -Wpragma-pack
    - -Wnonportable-include-path
  UnusedIncludes: None
  ClangTidy:
    Remove: "*"
