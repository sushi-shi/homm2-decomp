LIBRARY WING32.dll
DESCRIPTION 'WinG Win32 High Performance Graphics APIs'
EXPORTS
    WinGCreateDC=_WinGCreateDC@0 @3
    WinGRecommendDIBFormat=_WinGRecommendDIBFormat@4 @8
    WinGCreateBitmap=_WinGCreateBitmap@12 @2
    WinGGetDIBPointer=_WinGGetDIBPointer@8 @7
    WinGGetDIBColorTable=_WinGGetDIBColorTable@16 @6
    WinGSetDIBColorTable=_WinGSetDIBColorTable@16 @9
    WinGCreateHalftonePalette=_WinGCreateHalftonePalette@0 @5
    WinGCreateHalftoneBrush=_WinGCreateHalftoneBrush@12 @4
    WinGStretchBlt=_WinGStretchBlt@40 @10
    WinGBitBlt=_WinGBitBlt@32 @1
