ninja_required_version = 1.10
builddir = build/en
cxx = clang++
dlltool = llvm-dlltool
cxxflags = --target=i686-w64-windows-gnu -std=gnu++20 -O0 -mno-sse -mno-sse2 -mfpmath=387 -fms-extensions -fsjlj-exceptions -ferror-limit=0 -Wall -Wextra -Werror=unused-parameter -Werror=sign-compare -Werror=unused-variable -Werror=unused-but-set-variable -Werror=parentheses -Werror=write-strings -Wformat-security -Wno-error=format-security -Werror=enum-conversion -Werror=narrowing -D_X86_ -DWIN32 -D_WINDOWS -D_MT -Dregister= -Ibuild/en/localized/include -Ivendor/audiere-1.9.2 -Ivendor/miles-3.6 -Ivendor/smacker-3.0g -Ivendor/wing-1.0
ldflags = --target=i686-w64-windows-gnu -fuse-ld=lld -mwindows -fsjlj-exceptions -static -static-libgcc -static-libstdc++
system_libs = -lkernel32 -luser32 -lgdi32 -lwinmm -lws2_32 -lddraw -ldplayx -ladvapi32 -lole32 -luuid -lcomdlg32 -lshell32 -lnetapi32
runtime_libs = -Wl,--start-group -lstdc++ -lgcc_eh -lgcc -lmcfgthread -lntdll -Wl,--end-group

rule mkdir
  command = mkdir -p $out
  restat = 1

rule cxx
  command = $${CXX:-$cxx} $cxxflags -MMD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CXX $in

rule implib
  command = $dlltool -m i386 $dlltool_flags -d $in -l $out
  description = IMPLIB $in

rule link
  command = $${CXX:-$cxx} $ldflags -o $out $in $system_libs $runtime_libs
  description = LINK $out

build $builddir/obj: mkdir
build $builddir/imports: mkdir
rule localize
  command = python3 build.py --prepare --en
  restat = 1
  description = LOCALIZE en
build build/en/localized/include/BASE/BITS.h build/en/localized/include/BASE/Blur.h build/en/localized/include/BASE/Bzip.h build/en/localized/include/BASE/DebugCheck.h build/en/localized/include/BASE/EXEC_TYPES.h build/en/localized/include/BASE/INPUTMGR.h build/en/localized/include/BASE/Icon2b.h build/en/localized/include/BASE/IconDraw.h build/en/localized/include/BASE/IconEntry.h build/en/localized/include/BASE/IconMonoRle.h build/en/localized/include/BASE/IconRle.h build/en/localized/include/BASE/IconShear.h build/en/localized/include/BASE/Icond2b.h build/en/localized/include/BASE/Icondf2b.h build/en/localized/include/BASE/Iconf2b.h build/en/localized/include/BASE/Iconm2b.h build/en/localized/include/BASE/Iconmf2b.h build/en/localized/include/BASE/MIDIWrap.h build/en/localized/include/BASE/Midi.h build/en/localized/include/BASE/Misc.h build/en/localized/include/BASE/MiscEnums.h build/en/localized/include/BASE/MiscGraphicsConstants.h build/en/localized/include/BASE/MusicFlags.h build/en/localized/include/BASE/Ripple.h build/en/localized/include/BASE/TILE.h build/en/localized/include/BASE/WINMGR.h build/en/localized/include/BASE/baseManager.h build/en/localized/include/BASE/bitmap.h build/en/localized/include/BASE/bmap2.h build/en/localized/include/BASE/border.h build/en/localized/include/BASE/button.h build/en/localized/include/BASE/dimmerWidget.h build/en/localized/include/BASE/dropListWidget.h build/en/localized/include/BASE/executive.h build/en/localized/include/BASE/font.h build/en/localized/include/BASE/heroWindow.h build/en/localized/include/BASE/heroWindowManager.h build/en/localized/include/BASE/icon.h build/en/localized/include/BASE/icon2bc.h build/en/localized/include/BASE/icon2bs.h build/en/localized/include/BASE/icon2by.h build/en/localized/include/BASE/iconWidget.h build/en/localized/include/BASE/iconf2bc.h build/en/localized/include/BASE/iconf2by.h build/en/localized/include/BASE/inputManager.h build/en/localized/include/BASE/listBoxWidget.h build/en/